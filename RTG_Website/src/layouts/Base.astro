---
// Base layout every page renders through. Derives the whole <head> (title,
// meta, canonical, Open Graph, JSON-LD) from the page's Page Map entry, so
// it can never drift from the workbook. Templates supply body content only.
import { ClientRouter } from 'astro:transitions';
import { SITE, CONSENT } from '@data/site.js';
import { absolute, ogImageFor, buildJsonLd } from '@lib/seo';
import { resolvePage } from '@lib/page';
import { entryFor, UNFINISHED } from '@lib/content';
import Header from '@components/site/Header.astro';
import Footer from '@components/site/Footer.astro';
import DepthGauge from '@components/site/DepthGauge.astro';
import '@fontsource-variable/archivo/wght.css';
import '@fontsource-variable/inter/wght.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-wght-normal.woff2?url';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import '@/styles/tokens.css';
import '@/styles/blocks.css';
import '@/styles/surfaces.css';
import '@/styles/layout.css';
import '@/styles/parts-site.css';
import '@/styles/parts-content.css';
import '@/styles/parts-sections.css';
import '@/styles/ocean.css';

interface Props {
  /** Page Map id, e.g. 'S-02'. Unknown ids throw at build time. */
  pageId: string;
  /** Extra JSON-LD graph nodes for this template (FAQPage, per-vacancy JobPosting…) */
  jsonLd?: Record<string, unknown>[];
  /** Fields merged into the page's own JSON-LD node (Product additionalProperty, Article dates…) */
  jsonLdPage?: Record<string, unknown>;
}

const { pageId, jsonLd = [], jsonLdPage = {} } = Astro.props;
const { p, offMap } = resolvePage(pageId);

const canonical = absolute(p.slug);
const ogImage = ogImageFor(p);
const schema = buildJsonLd(p, jsonLd, jsonLdPage);

// Off-map pages (404) are never indexed. Neither is a page that is still a
// working outline — draft: true, or carrying a <Gap> / TO SUPPLY marker —
// so internal notes to RTG never reach a search index. The same test keeps
// those pages out of the sitemap (astro.config.mjs); it clears itself the
// moment the page is finished. A finished page stays indexable even when
// Gated, since the form gates the asset, not the page.
const entry = offMap ? undefined : await entryFor(pageId);
const unfinished = !!entry && (entry.data.draft || UNFINISHED.test((entry.body ?? '') + JSON.stringify(entry.data)));
const robots = offMap || unfinished ? 'noindex, follow' : 'index, follow, max-image-preview:large';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* Blocking on purpose: must land before first paint so JS-enabled
       browsers never flash revealed content that then hides. A no-JS visit
       never runs it, so .rl/.fu/.stag stay visible by default (tokens.css). */}
    <script is:inline>document.documentElement.classList.add('js');</script>

    <title>{p.title}</title>
    <meta name="description" content={p.description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#031d5b" />

    <meta property="og:type" content={p.schema === 'Article' ? 'article' : 'website'} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={p.title} />
    <meta property="og:description" content={p.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {p.ogBrief && <meta property="og:image:alt" content={p.ogBrief} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={p.title} />
    <meta name="twitter:description" content={p.description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preload" as="font" type="font/woff2" href={archivoLatin} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={interLatin} crossorigin />

    <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} is:inline />

    <ClientRouter />

    {/* Cookie consent (CLAUDE.md §5.4). OneTrust shows the banner and the
       settings panel; nothing else third-party loads until the visitor has
       agreed to its category. OneTrust calls OptanonWrapper() once it has
       loaded and again after every change of choice, so that one function
       is the only place analytics and the chat are ever started:
         Performance (C0002) -> Google Analytics
         Functional  (C0003) -> Chatra, whose own "Message us" button is
                                the site's only chat control
       Each is started at most once (w.__ga, w.ChatraID): these scripts ride
       along on every ClientRouter navigation and the services persist
       across them. Withdrawing Performance sets Google's own kill switch so
       no further hits are sent; the script itself is gone on the next full
       load. is:inline (implied by define:vars) so Astro ships it verbatim. */}
    <script define:vars={{ consent: CONSENT }}>
      (function (d, w) {
        w.OptanonWrapper = function () {
          var groups = w.OnetrustActiveGroups || '';
          var performance = groups.indexOf(consent.performance) > -1;
          // The chat is Functional. The OneTrust configuration lists nothing
          // under that category yet, and OneTrust does not offer a category
          // with nothing in it, so until Chatra is added there in the
          // OneTrust dashboard the chat counts as agreed only when every
          // optional category that IS offered has been switched on, which is
          // what "Accept All Cookies" does. Once Functional is offered, it
          // alone decides.
          var data = w.OneTrust && w.OneTrust.GetDomainData ? w.OneTrust.GetDomainData() : { Groups: [] };
          var offered = data.Groups.filter(function (g) {
            return g.Status !== 'always active' && ((g.FirstPartyCookies || []).length || (g.Hosts || []).length);
          }).map(function (g) { return g.OptanonGroupId; });
          var functional = offered.indexOf(consent.functional) > -1
            ? groups.indexOf(consent.functional) > -1
            : offered.length > 0 && offered.every(function (id) { return groups.indexOf(id) > -1; });

          w['ga-disable-' + consent.analytics] = !performance;
          if (performance && !w.__ga) {
            w.__ga = true;
            w.dataLayer = w.dataLayer || [];
            w.gtag = function () { w.dataLayer.push(arguments); };
            w.gtag('js', new Date());
            w.gtag('config', consent.analytics);
            var g = d.createElement('script');
            g.async = true;
            g.src = 'https://www.googletagmanager.com/gtag/js?id=' + consent.analytics;
            d.head.appendChild(g);
          }

          if (functional && !w.ChatraID) {
            w.ChatraID = consent.chatra;
            w.Chatra = w.Chatra || function () { (w.Chatra.q = w.Chatra.q || []).push(arguments); };
            var c = d.createElement('script');
            c.async = true;
            c.src = 'https://call.chatra.io/chatra.js';
            d.head.appendChild(c);
          }
        };

        // "Cookie settings" links (footer, cookie policy) open OneTrust's
        // panel. Delegated, because the footer is replaced on every
        // navigation. Until OneTrust has loaded, or if it is blocked, the
        // link simply goes to the cookie policy it points at.
        if (w.__cookieSettings) return;
        w.__cookieSettings = true;
        // OneTrust and Chatra put their own elements at the end of <body>,
        // and a ClientRouter navigation replaces the body: carry them over,
        // or the banner, the settings panel and the chat vanish on the
        // first click through the site.
        d.addEventListener('astro:before-swap', function (e) {
          d.querySelectorAll('#onetrust-consent-sdk, [id^="chatra"]').forEach(function (el) {
            if (el.parentElement === d.body) e.newDocument.body.appendChild(el);
          });
          // ...and the stylesheets they injected into <head>, which the
          // router would otherwise drop, leaving the panel as bare text.
          d.head.querySelectorAll('style[id^="onetrust"], style[id*="hatra"], style[class*="hatra"]').forEach(function (el) {
            e.newDocument.head.appendChild(el);
          });
        });
        d.addEventListener('click', function (e) {
          var link = e.target.closest && e.target.closest('[data-cookie-settings]');
          if (!link || !w.OneTrust || !w.OneTrust.ToggleInfoDisplay) return;
          e.preventDefault();
          w.OneTrust.ToggleInfoDisplay();
        });
      })(document, window);
    </script>
    <script is:inline src="https://cdn.cookielaw.org/scripttemplates/otSDKStub.js" data-domain-script={CONSENT.oneTrust}></script>

    <slot name="head" />
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header currentPath={p.slug} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <DepthGauge />
    <slot name="body-end" />

    <script>
      import { initMotion } from '@lib/motion';
      import { initFormPrefill } from '@lib/forms';
      import { initDepth } from '@lib/depth';
      // astro:page-load fires on first load and after every client-side
      // navigation — the one place reveals, counters and parallax get
      // booted. Don't call initMotion() again from a template: home-scroll.ts
      // relies on this having already run and only layers the homepage's
      // 3D on top.
      document.addEventListener('astro:page-load', initMotion);
      document.addEventListener('astro:page-load', initFormPrefill);
      document.addEventListener('astro:page-load', initDepth);
    </script>

  </body>
</html>
