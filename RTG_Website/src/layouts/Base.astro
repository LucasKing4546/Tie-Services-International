---
// Base layout every page renders through. Derives the whole <head> (title,
// meta, canonical, Open Graph, JSON-LD) from the page's Page Map entry, so
// it can never drift from the workbook. Templates supply body content only.
import { ClientRouter } from 'astro:transitions';
import { SITE } from '@data/site.js';
import { absolute, ogImageFor, buildJsonLd } from '@lib/seo';
import { resolvePage } from '@lib/page';
import Header from '@components/site/Header.astro';
import Footer from '@components/site/Footer.astro';
import '@/styles/tokens.css';
import '@/styles/blocks.css';
import '@/styles/surfaces.css';
import '@/styles/layout.css';
import '@/styles/parts-site.css';
import '@/styles/parts-content.css';
import '@/styles/parts-sections.css';

interface Props {
  /** Page Map id, e.g. 'S-02'. Unknown ids throw at build time. */
  pageId: string;
  /** Extra JSON-LD graph nodes for this template (FAQPage, per-vacancy JobPosting…) */
  jsonLd?: Record<string, unknown>[];
  /** Fields merged into the page's own JSON-LD node (Product additionalProperty, Article dates…) */
  jsonLdPage?: Record<string, unknown>;
}

const { pageId, jsonLd = [], jsonLdPage = {} } = Astro.props;
const { p, offMap } = resolvePage(pageId);

const canonical = absolute(p.slug);
const ogImage = ogImageFor(p);
const schema = buildJsonLd(p, jsonLd, jsonLdPage);

// Off-map pages (404) are never indexed; every real workbook page stays
// indexable even when Gated, since the form gates the asset, not the page.
const robots = offMap ? 'noindex, follow' : 'index, follow, max-image-preview:large';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* Blocking on purpose: must land before first paint so JS-enabled
       browsers never flash revealed content that then hides. A no-JS visit
       never runs it, so .rl/.fu/.stag stay visible by default (tokens.css). */}
    <script is:inline>document.documentElement.classList.add('js');</script>

    <title>{p.title}</title>
    <meta name="description" content={p.description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#031d5b" />

    <meta property="og:type" content={p.schema === 'Article' ? 'article' : 'website'} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={p.title} />
    <meta property="og:description" content={p.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {p.ogBrief && <meta property="og:image:alt" content={p.ogBrief} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={p.title} />
    <meta name="twitter:description" content={p.description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800;900&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />

    <ClientRouter />

    <slot name="head" />
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header currentPath={p.slug} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <slot name="body-end" />

    <script>
      import { initMotion } from '@lib/motion';
      import { initFormPrefill } from '@lib/forms';
      // astro:page-load fires on first load and after every client-side
      // navigation — the one place reveals, counters and parallax get
      // booted. Don't call initMotion() again from a template: home-scroll.ts
      // relies on this having already run and only layers the homepage's
      // 3D on top.
      document.addEventListener('astro:page-load', initMotion);
      document.addEventListener('astro:page-load', initFormPrefill);
    </script>

    <script is:inline>
      if (matchMedia('(pointer:fine) and (prefers-reduced-motion:no-preference)').matches)
        document.addEventListener('pointermove', function (e) {
          var c = e.target.closest && e.target.closest('.ecard');
          if (!c) return;
          var r = c.getBoundingClientRect();
          c.style.setProperty('--mx', e.clientX - r.left + 'px');
          c.style.setProperty('--my', e.clientY - r.top + 'px');
        }, { passive: true });
    </script>

    {/* Chatra live chat, same ID as production. is:inline so Astro ships it
       verbatim. Guarded on w.ChatraID because this script's markup rides
       along on every ClientRouter navigation — without the guard, a
       client-side nav would inject a second chatra.js and widget instance.
       Flag: no consent gate exists yet for any third party here, matching
       the current site — revisit once consent management lands (CLAUDE.md §5.4). */}
    <script is:inline>
      (function (d, w, c) {
        if (w.ChatraID) return;
        w.ChatraID = 'iraKxKmohhNY38Mu9';
        var s = d.createElement('script');
        w[c] = w[c] || function () { (w[c].q = w[c].q || []).push(arguments); };
        s.async = true;
        s.src = 'https://call.chatra.io/chatra.js';
        if (d.head) d.head.appendChild(s);
      })(document, window, 'Chatra');
    </script>
  </body>
</html>
