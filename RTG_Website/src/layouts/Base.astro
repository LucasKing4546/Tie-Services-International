---
/**
 * Base layout. Every page in the site renders through this.
 *
 * It takes a page id from the Page Map and derives the entire <head> from it,
 * so title tags, meta descriptions, canonicals, Open Graph and JSON-LD can
 * never drift from the workbook. Templates supply body content only.
 */
import { page as lookupPage, type PageMeta } from '@data/pages';
import { SITE } from '@data/site.js';
import { absolute, ogImageFor, buildJsonLd } from '@lib/seo';
import Header from '@components/site/Header.astro';
import Footer from '@components/site/Footer.astro';
import '@/styles/tokens.css';

interface Props {
  /** Page Map id, e.g. 'S-02'. Unknown ids throw at build time. */
  pageId: string;
  /** Extra JSON-LD nodes for this template (Product specs, Article dates, …) */
  jsonLd?: Record<string, unknown>[];
  /** Set on the homepage only — it renders its own full-bleed hero */
  bare?: boolean;
}

const { pageId, jsonLd = [], bare = false } = Astro.props;
const p: PageMeta = lookupPage(pageId);

const canonical = absolute(p.slug);
const ogImage = ogImageFor(p);
const schema = buildJsonLd(p, jsonLd);

// Gated pages stay indexable but must never expose the asset itself.
const robots =
  p.access === 'Gated'
    ? 'index, follow, max-image-preview:large'
    : 'index, follow, max-image-preview:large';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{p.title}</title>
    <meta name="description" content={p.description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#031d5b" />

    <meta property="og:type" content={p.schema === 'Article' ? 'article' : 'website'} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={p.title} />
    <meta property="og:description" content={p.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {p.ogBrief && <meta property="og:image:alt" content={p.ogBrief} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={p.title} />
    <meta name="twitter:description" content={p.description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800;900&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />

    <slot name="head" />
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header currentPath={p.slug} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <slot name="body-end" />
  </body>
</html>
