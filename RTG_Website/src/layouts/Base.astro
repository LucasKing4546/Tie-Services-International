---
/**
 * Base layout. Every page in the site renders through this.
 *
 * It takes a page id from the Page Map and derives the entire <head> from it,
 * so title tags, meta descriptions, canonicals, Open Graph and JSON-LD can
 * never drift from the workbook. Templates supply body content only.
 */
import { ClientRouter } from 'astro:transitions';
import { SITE } from '@data/site.js';
import { absolute, ogImageFor, buildJsonLd } from '@lib/seo';
import { resolvePage } from '@lib/page';
import Header from '@components/site/Header.astro';
import Footer from '@components/site/Footer.astro';
import '@/styles/tokens.css';
import '@/styles/blocks.css';

interface Props {
  /** Page Map id, e.g. 'S-02'. Unknown ids throw at build time. */
  pageId: string;
  /** Extra JSON-LD graph nodes for this template (FAQPage, per-vacancy JobPosting…) */
  jsonLd?: Record<string, unknown>[];
  /** Fields merged into the page's own JSON-LD node (Product additionalProperty, Article dates…) */
  jsonLdPage?: Record<string, unknown>;
}

const { pageId, jsonLd = [], jsonLdPage = {} } = Astro.props;
const { p, offMap } = resolvePage(pageId);

const canonical = absolute(p.slug);
const ogImage = ogImageFor(p);
const schema = buildJsonLd(p, jsonLd, jsonLdPage);

// Off-map pages (404) are never indexed. Every real workbook page stays
// indexable even when Gated — the form stands in front of the asset, not
// the page describing it.
const robots = offMap ? 'noindex, follow' : 'index, follow, max-image-preview:large';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* Synchronous and blocking, on purpose: this must land before first
       paint so JS-enabled browsers never show a flash of revealed content
       that then hides. A no-JS visit never runs it, so .rl/.fu/.stag stay
       visible by default — see tokens.css. */}
    <script is:inline>document.documentElement.classList.add('js');</script>

    <title>{p.title}</title>
    <meta name="description" content={p.description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#031d5b" />

    <meta property="og:type" content={p.schema === 'Article' ? 'article' : 'website'} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={p.title} />
    <meta property="og:description" content={p.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {p.ogBrief && <meta property="og:image:alt" content={p.ogBrief} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={p.title} />
    <meta name="twitter:description" content={p.description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800;900&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />

    <ClientRouter />

    <slot name="head" />
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header currentPath={p.slug} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <slot name="body-end" />

    <script>
      import { initMotion } from '@lib/motion';
      import { initFormPrefill } from '@lib/forms';
      // Fires on first load AND after every client-side navigation under
      // ClientRouter — the one place every template's reveals, counters
      // and parallax hooks get booted. Do not call initMotion() a second
      // time from a template; home-scroll.ts relies on this already having
      // run and only adds the homepage's 3D on top of it.
      document.addEventListener('astro:page-load', initMotion);
      document.addEventListener('astro:page-load', initFormPrefill);
    </script>

    {/* Chatra live chat — same embed and ID as the current production site
       (www.romicatiegroup.com), loaded on every page. Chatra appends its
       own script to <head> asynchronously; is:inline so Astro ships it
       verbatim rather than bundling it. Guarded on w.ChatraID rather than
       run unconditionally like the reference snippet: under ClientRouter
       this script rides along on every page's markup, and if it ever runs
       more than once (server-rendered HTML on first load, then again on a
       client-side navigation) it would inject a second chatra.js and a
       second widget instance — the guard makes re-running it a no-op.
       Flag (CLAUDE.md §5.4): no consent gate exists yet for ANY third
       party on this site, analytics included — this matches what the
       current site already does, not a new gap this introduces. Revisit
       once real consent management lands. */}
    <script is:inline>
      (function (d, w, c) {
        if (w.ChatraID) return;
        w.ChatraID = 'iraKxKmohhNY38Mu9';
        var s = d.createElement('script');
        w[c] = w[c] || function () { (w[c].q = w[c].q || []).push(arguments); };
        s.async = true;
        s.src = 'https://call.chatra.io/chatra.js';
        if (d.head) d.head.appendChild(s);
      })(document, window, 'Chatra');
    </script>
  </body>
</html>
