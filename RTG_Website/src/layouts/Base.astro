---
// Base layout every page renders through. Derives the whole <head> (title,
// meta, canonical, Open Graph, JSON-LD) from the page's Page Map entry, so
// it can never drift from the workbook. Templates supply body content only.
import { ClientRouter } from 'astro:transitions';
import { SITE } from '@data/site.js';
import { absolute, ogImageFor, buildJsonLd } from '@lib/seo';
import { resolvePage } from '@lib/page';
import { entryFor, UNFINISHED } from '@lib/content';
import Header from '@components/site/Header.astro';
import Footer from '@components/site/Footer.astro';
import DepthGauge from '@components/site/DepthGauge.astro';
import '@fontsource-variable/archivo/wght.css';
import '@fontsource-variable/inter/wght.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-wght-normal.woff2?url';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import '@/styles/tokens.css';
import '@/styles/blocks.css';
import '@/styles/surfaces.css';
import '@/styles/layout.css';
import '@/styles/parts-site.css';
import '@/styles/parts-content.css';
import '@/styles/parts-sections.css';
import '@/styles/ocean.css';

interface Props {
  /** Page Map id, e.g. 'S-02'. Unknown ids throw at build time. */
  pageId: string;
  /** Extra JSON-LD graph nodes for this template (FAQPage, per-vacancy JobPosting…) */
  jsonLd?: Record<string, unknown>[];
  /** Fields merged into the page's own JSON-LD node (Product additionalProperty, Article dates…) */
  jsonLdPage?: Record<string, unknown>;
}

const { pageId, jsonLd = [], jsonLdPage = {} } = Astro.props;
const { p, offMap } = resolvePage(pageId);

const canonical = absolute(p.slug);
const ogImage = ogImageFor(p);
const schema = buildJsonLd(p, jsonLd, jsonLdPage);

// Off-map pages (404) are never indexed. Neither is a page that is still a
// working outline — draft: true, or carrying a <Gap> / TO SUPPLY marker —
// so internal notes to RTG never reach a search index. The same test keeps
// those pages out of the sitemap (astro.config.mjs); it clears itself the
// moment the page is finished. A finished page stays indexable even when
// Gated, since the form gates the asset, not the page.
const entry = offMap ? undefined : await entryFor(pageId);
const unfinished = !!entry && (entry.data.draft || UNFINISHED.test((entry.body ?? '') + JSON.stringify(entry.data)));
const robots = offMap || unfinished ? 'noindex, follow' : 'index, follow, max-image-preview:large';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* Blocking on purpose: must land before first paint so JS-enabled
       browsers never flash revealed content that then hides. A no-JS visit
       never runs it, so .rl/.fu/.stag stay visible by default (tokens.css). */}
    <script is:inline>document.documentElement.classList.add('js');</script>

    <title>{p.title}</title>
    <meta name="description" content={p.description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#031d5b" />

    <meta property="og:type" content={p.schema === 'Article' ? 'article' : 'website'} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={p.title} />
    <meta property="og:description" content={p.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {p.ogBrief && <meta property="og:image:alt" content={p.ogBrief} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={p.title} />
    <meta name="twitter:description" content={p.description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preload" as="font" type="font/woff2" href={archivoLatin} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={interLatin} crossorigin />

    <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} is:inline />

    <ClientRouter />

    <slot name="head" />
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header currentPath={p.slug} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <DepthGauge />
    <slot name="body-end" />

    <script>
      import { initMotion } from '@lib/motion';
      import { initFormPrefill } from '@lib/forms';
      import { initDepth } from '@lib/depth';
      // astro:page-load fires on first load and after every client-side
      // navigation — the one place reveals, counters and parallax get
      // booted. Don't call initMotion() again from a template: home-scroll.ts
      // relies on this having already run and only layers the homepage's
      // 3D on top.
      document.addEventListener('astro:page-load', initMotion);
      document.addEventListener('astro:page-load', initFormPrefill);
      document.addEventListener('astro:page-load', initDepth);
    </script>

    {/* Chatra live chat, same ID as production. Its own "Message us" button
       is the only chat control: the site owner asked on 2026-10-13 for our
       separate launcher to go, so the script now loads with the page rather
       than on a click. That makes it a third party loaded before consent
       (CLAUDE.md §5.4), which a consent banner has to cover before launch.
       is:inline so Astro ships it verbatim; w.ChatraID guards against a
       second load, since this markup rides along on every ClientRouter
       navigation and the widget persists across them. */}
    <script is:inline>
      (function (d, w, c) {
        if (w.ChatraID) return;
        w.ChatraID = 'iraKxKmohhNY38Mu9';
        var s = d.createElement('script');
        w[c] = w[c] || function () { (w[c].q = w[c].q || []).push(arguments); };
        s.async = true;
        s.src = 'https://call.chatra.io/chatra.js';
        d.head.appendChild(s);
      })(document, window, 'Chatra');
    </script>
  </body>
</html>
