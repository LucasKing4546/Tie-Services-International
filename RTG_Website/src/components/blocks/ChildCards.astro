---
/**
 * A hub's children, rendered as a CardGrid. Items come from childEntries(),
 * one path segment deeper than `of`, so a new Page Map row under a hub's
 * slug appears here automatically with no hand-written child list.
 */
import { childEntries } from '@lib/content';
import type { CardItem } from '@lib/blocks';
import CardGrid from './CardGrid.astro';
import ScrollTrack from './ScrollTrack.astro';
import IndexRows from './IndexRows.astro';
import Card from './Card.astro';

interface Props {
  of: string;
  cols?: 2 | 3;
  /** Accessible name for the carousel — see CardGrid.astro. */
  label?: string;
  /** Page ids to leave out, e.g. one already surfaced via a "featured" block. */
  exclude?: string[];
  /** Curated cards to append after the derived children (resolve frontmatter
   *  `cards` through cardFrom() first). Not deduplicated against the derived
   *  children — add an id to `exclude` if an `extra` entry would double up. */
  extra?: CardItem[];
  /** Ask for the full-bleed navy set-piece rather than a light carousel —
   *  see TRACK_MIN below: asking is not the same as getting one. */
  track?: boolean;
  eyebrow?: string;
  heading?: string;
}

/** Below this a track has nothing to scroll — the rail never moves and the
 *  pin refuses to engage — so it falls back to IndexRows instead. */
const TRACK_MIN = 5;

const {
  of, cols = 3, label = 'Related pages', exclude = [], extra = [],
  track = false, eyebrow, heading,
} = Astro.props;
const pairs = (await childEntries(of)).filter(({ page }) => !exclude.includes(page.id));
const items: CardItem[] = [
  ...pairs.map(({ page, entry }) => ({
    title: page.name,
    href: page.slug,
    blurb: entry.data.lede ?? page.description,
  })),
  ...extra,
];
---

{track && items.length >= TRACK_MIN ? (
  <ScrollTrack eyebrow={eyebrow} heading={heading ?? label}>
    {items.map((item) => <Card item={item} tone="dark" />)}
  </ScrollTrack>
) : track ? (
  <IndexRows items={items} eyebrow={eyebrow} heading={heading ?? label} />
) : (
  <CardGrid cols={cols} label={label}>
    {items.map((item) => <Card item={item} />)}
  </CardGrid>
)}
