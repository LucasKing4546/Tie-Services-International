---
/**
 * A hub's children, rendered as a CardGrid. Items come from childEntries(),
 * one path segment deeper than `of`, so a new Page Map row under a hub's
 * slug appears here automatically with no hand-written child list.
 */
import { childEntries } from '@lib/content';
import { sentenceCase, type CardItem } from '@lib/blocks';
import CardGrid from './CardGrid.astro';
import PhotoList from './PhotoList.astro';
import { mediaFor } from '@data/media';
import Card from './Card.astro';

interface Props {
  of: string;
  cols?: 2 | 3;
  /** Accessible name for the carousel — see CardGrid.astro. */
  label?: string;
  /** Page ids to leave out, e.g. one already surfaced via a "featured" block. */
  exclude?: string[];
  /** Curated cards (resolve frontmatter `cards` through cardFrom() first).
   *  One that points at a derived child replaces that child's card where it
   *  stands, so a hub can word its own rows; the rest append after. */
  extra?: CardItem[];
  /** A hub's own list: ruled photo rows (PhotoList) instead of a card
   *  grid. Hubs were carousels until 2026-11-05. */
  track?: boolean;
  eyebrow?: string;
  heading?: string;
}

const {
  of, cols = 3, label = 'Related pages', exclude = [], extra = [],
  track = false, eyebrow, heading,
} = Astro.props;
const pairs = (await childEntries(of)).filter(({ page }) => !exclude.includes(page.id));
const curated = new Map(extra.map((c) => [c.href, c]));
// Each child's photograph: the first of its own images (hero, then
// supporting) that has a real photo registered in @data/media.
// A child with none of its own (the Winches hub) borrows the first photo
// found on its own child pages.
type Entry = (typeof pairs)[number]['entry'];
const ownPhoto = (entry: Entry) =>
  [entry.data.hero.media?.ref, ...entry.data.media.map((m) => m.ref)].find((r) => r && mediaFor(r));
const photoOf = async (slug: string, entry: Entry) =>
  ownPhoto(entry) ?? (await childEntries(slug)).map(({ entry: e }) => ownPhoto(e)).find(Boolean);
const photos = new Map(await Promise.all(pairs.map(async ({ page, entry }) => [page.slug, await photoOf(page.slug, entry)] as const)));
const items: CardItem[] = [
  ...pairs.map(({ page, entry }) => ({
    ...(curated.get(page.slug) ?? {
      title: sentenceCase(page.name),
      href: page.slug,
      blurb: entry.data.lede ?? page.description,
    }),
    ref: photos.get(page.slug),
  })),
  ...extra.filter((c) => !pairs.some(({ page }) => page.slug === c.href)),
];
---

{track ? (
  <PhotoList heading={heading ?? label} items={items} label={label} />
) : (
  <CardGrid cols={cols} label={label}>
    {items.map((item) => <Card item={item} />)}
  </CardGrid>
)}
