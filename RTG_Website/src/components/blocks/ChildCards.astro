---
/**
 * A hub's children, rendered as a CardGrid — no hand-written child list.
 * Items come from childrenOf() (src/data/pages.ts), one path segment
 * deeper than `of`, so a new Page Map row under a hub's slug appears here
 * automatically. This is what replaces src/data/home.ts's hand-typed
 * SECTORS/TIERS arrays once the templates that need them exist.
 */
import { childEntries } from '@lib/content';
import type { CardItem } from '@lib/blocks';
import CardGrid from './CardGrid.astro';
import ScrollTrack from './ScrollTrack.astro';
import IndexRows from './IndexRows.astro';
import Card from './Card.astro';

interface Props {
  of: string;
  cols?: 2 | 3;
  /** Accessible name for the carousel — see CardGrid.astro. */
  label?: string;
  /** Page ids to leave out — rare, for a hub that surfaces one child via a
   *  different block (a "featured" case study, say) and doesn't want it
   *  doubled up in the grid. */
  exclude?: string[];
  /** Curated cards to append after the derived children — for a cross-link
   *  outside the hub's own branch (e.g. the Proof hub linking to Yards &
   *  Integrators' Certifications page). Resolve frontmatter `cards` through
   *  cardFrom() and pass the result here, rather than a hub hand-typing a
   *  second, disconnected card grid. Not deduplicated against the derived
   *  children — if an `extra` entry ever points at one of the hub's own
   *  children, add that child's id to `exclude` to avoid showing it twice. */
  extra?: CardItem[];
  /** Ask for the full-bleed navy set-piece rather than a light carousel.
   *  A hub's children are the page's main event, so this is what Hub.astro
   *  uses — but see TRACK_MIN below: asking is not the same as getting one. */
  track?: boolean;
  eyebrow?: string;
  heading?: string;
}

/** Below this a track has nothing to scroll: the rail never moves, the
 *  prev/next buttons do nothing and the pin refuses to engage, so it reads
 *  as a set-piece that failed rather than as a layout. Fourteen of the
 *  site's nineteen tracks were under it. Those get IndexRows instead — see
 *  that component for why a register beats both a carousel and a grid at
 *  this size. */
const TRACK_MIN = 5;

const {
  of, cols = 3, label = 'Related pages', exclude = [], extra = [],
  track = false, eyebrow, heading,
} = Astro.props;
const pairs = (await childEntries(of)).filter(({ page }) => !exclude.includes(page.id));
const items: CardItem[] = [
  ...pairs.map(({ page, entry }) => ({
    title: page.name,
    href: page.slug,
    blurb: entry.data.lede ?? page.description,
  })),
  ...extra,
];
---

{track && items.length >= TRACK_MIN ? (
  <ScrollTrack eyebrow={eyebrow} heading={heading ?? label}>
    {items.map((item) => <Card item={item} tone="dark" />)}
  </ScrollTrack>
) : track ? (
  <IndexRows items={items} eyebrow={eyebrow} heading={heading ?? label} />
) : (
  <CardGrid cols={cols} label={label}>
    {items.map((item) => <Card item={item} />)}
  </CardGrid>
)}
