---
/** One form field — mirrors the reference build's form() field renderer
 *  (site_build/site_data.py:88), same label/hint/required conventions. */
import type { FieldSpec } from '@lib/blocks';

interface Props { field: FieldSpec }
const { field } = Astro.props;
---

<div class="field">
  <label for={field.name}>
    {field.label}
    {field.required && <em> *</em>}
  </label>
  {field.type === 'textarea' ? (
    <textarea id={field.name} name={field.name} required={field.required}></textarea>
  ) : field.type === 'select' ? (
    <select id={field.name} name={field.name} required={field.required}>
      <option value="">Please choose…</option>
      {field.options.map((o) => <option value={o}>{o}</option>)}
    </select>
  ) : (
    <input type={field.type} id={field.name} name={field.name} required={field.required} />
  )}
  {field.hint && <p class="hint">{field.hint}</p>}
</div>
