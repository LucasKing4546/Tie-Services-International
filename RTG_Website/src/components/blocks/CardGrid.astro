---
/** .ecard cards rendered in a Carousel. `cols` maps to "cards visible per
 *  view" (see Carousel.astro's `perView`). */
import Carousel from './Carousel.astro';

interface Props {
  cols?: 2 | 3;
  /** Accessible name for the carousel region — pass the section's own
   *  heading text where one exists. */
  label: string;
}

const { cols = 3, label } = Astro.props;
---

<Carousel label={label} perView={cols}>
  <slot />
</Carousel>
