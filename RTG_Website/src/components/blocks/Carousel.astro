---
/**
 * The shared carousel track. CSS scroll-snap does the actual work; this
 * supplies the markup that blocks.css (.car/.car-track/.car-nav) and
 * initCarousels() (lib/motion.ts) hook onto.
 *
 * The prev/next buttons are always in the markup but stay display:none
 * until html.js confirms initCarousels() can drive them, so a script-
 * disabled visit (where the track still scrolls natively) never sees dead
 * buttons — the same gate .fu/.stag use.
 *
 * The .stag reveal still works inside the track: IntersectionObserver
 * treats cards clipped by the track's own horizontal scrolling as
 * not-yet-intersecting (clipping ancestors count, not just the viewport),
 * so a card reveals the first time it's actually scrolled into view.
 */
interface Props {
  /** Accessible name for the scrollable region and its nav buttons. */
  label: string;
  /** Cards visible at the widest breakpoint. */
  perView?: 2 | 3;
  reveal?: boolean;
}

const { label, perView = 3, reveal = true } = Astro.props;
---

<div class:list={['car', { 'car-2': perView === 2 }]} data-carousel>
  <div class:list={['car-track', { stag: reveal }]} role="region" aria-label={label} tabindex="0">
    <slot />
  </div>
  <div class="car-nav">
    <button type="button" class="car-btn car-prev" aria-label={`Previous — ${label}`}>‹</button>
    <button type="button" class="car-btn car-next" aria-label={`Next — ${label}`}>›</button>
  </div>
</div>
