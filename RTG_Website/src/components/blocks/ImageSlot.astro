---
/**
 * A photograph where one exists, and an honest placeholder where one does
 * not (CLAUDE.md §5.5).
 *
 * The ref is looked up in src/data/media.ts. A hit renders an optimised
 * <Image> — responsive widths, AVIF/WebP, explicit dimensions so nothing
 * shifts as it loads. A miss renders the drawing-sheet plate: a <figure
 * role="img" aria-label> carrying the brief, so the alt-text audit
 * (scripts/audit-seo.mjs) is satisfied honestly rather than faked with an
 * empty alt on an element with no image behind it.
 *
 * The consequence worth stating: a page never changes when its photograph
 * arrives. It keeps the same ref in frontmatter, and the slot switches from
 * plate to picture on its own.
 */
import { Image } from 'astro:assets';
import { mediaFor } from '@data/media';
import type { MotionHint } from '@lib/blocks';

interface Props {
  /** Image Brief ref from the workbook, e.g. 'IMG-05'. */
  ref: string;
  brief: string;
  /** CSS aspect-ratio, e.g. '4/3', '16/9'. Defaults to 4/3. */
  ratio?: string;
  motion?: MotionHint;
  class?: string;
  /** Skip lazy-loading — set on anything above the fold. */
  eager?: boolean;
}

const { ref, brief, ratio, motion = 'none', class: cls, eager = false } = Astro.props;
const motionAttr = motion !== 'none' ? motion : undefined;
const photo = mediaFor(ref);

// The box takes the photograph's own shape. A ratio written by hand in
// frontmatter is a guess about a picture nobody has seen yet, and a wrong
// guess crops the subject out: the supplied set runs from a 0.71 portrait to
// a 2.80 panorama, and forcing either into a 16/9 box throws away most of
// it. An explicit `ratio` still wins where a fixed crop is genuinely wanted
// (a card face, a tile that has to line up with its neighbours); otherwise
// the image decides, and a slot with no photograph yet falls back to the
// brief's ratio or 4/3 so the placeholder plate still reserves the space.
const naturalRatio = photo ? `${photo.width}/${photo.height}` : undefined;
const boxRatio = ratio ?? naturalRatio;
// Never paint a photograph larger than it actually is. Several supplied
// files are small (791x445, 596x335); stretched across a full-width band
// they go soft, and a soft picture reads as a cheap one. Capping at the
// intrinsic width makes a small image sit smaller, which looks deliberate.
const style = [
  boxRatio ? `--imgslot-ratio:${boxRatio}` : '',
  photo ? `--imgslot-maxw:${photo.width}px` : '',
].filter(Boolean).join(';') || undefined;

/** portrait | square | landscape — lets a caller lay tiles out by shape. */
const orient = photo
  ? photo.width / photo.height < 0.95
    ? 'portrait'
    : photo.width / photo.height < 1.15
      ? 'square'
      : 'landscape'
  : undefined;
---

{photo ? (
  <figure
    class:list={['imgslot', 'imgslot-shot', cls]}
    style={style}
    data-motion={motionAttr}
    data-orient={orient}
  >
    <Image
      src={photo}
      alt={brief}
      widths={[640, 1024, 1600, 2200]}
      sizes="(max-width: 900px) 100vw, 55vw"
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
  </figure>
) : (
  <figure class:list={['imgslot', cls]} role="img" aria-label={brief} style={style} data-motion={motionAttr}>
    <b>{ref}</b>
    <span>{brief}</span>
  </figure>
)}
