---
/**
 * A photograph where one exists, and an honest placeholder where one does
 * not (CLAUDE.md §5.5). The ref is looked up in src/data/media.ts: a hit
 * renders an optimised <Image> (responsive widths, AVIF/WebP, explicit
 * dimensions); a miss renders a <figure role="img" aria-label> carrying
 * the brief, so the alt-text audit is satisfied honestly rather than faked
 * with an empty alt on an element with no image behind it. Either way the
 * ref in frontmatter stays the same — a page needs no edit when its
 * photograph arrives.
 */
import { Image } from 'astro:assets';
import { mediaFor } from '@data/media';
import type { MotionHint } from '@lib/blocks';

interface Props {
  /** Image Brief ref from the workbook, e.g. 'IMG-05'. */
  ref: string;
  brief: string;
  /** CSS aspect-ratio, e.g. '4/3', '16/9'. Defaults to 4/3. */
  ratio?: string;
  motion?: MotionHint;
  class?: string;
  /** Skip lazy-loading — set on anything above the fold. */
  eager?: boolean;
  /** How wide this slot actually renders, for srcset selection. The default
   *  assumes a column of roughly half the page; a caller whose layout knows
   *  better (MediaBand sizes its tiles by aspect ratio) should say so, or
   *  the browser picks a candidate narrower than the box and the picture is
   *  scaled up to fit. */
  sizes?: string;
}

const {
  ref, brief, ratio, motion = 'none', class: cls, eager = false,
  sizes = '(max-width: 900px) 100vw, 55vw',
} = Astro.props;
const motionAttr = motion !== 'none' ? motion : undefined;
const photo = mediaFor(ref);

// The box takes the photograph's own shape by default — an explicit `ratio`
// wins only where a fixed crop is genuinely wanted (a card face, a tile that
// must line up with its neighbours). Without one, a wrong hand-written guess
// would crop the subject: the supplied set runs from a 0.71 portrait to a
// 2.80 panorama. A slot with no photograph yet falls back to the brief's
// ratio, or 4/3, so the placeholder plate still reserves the space.
const naturalRatio = photo ? `${photo.width}/${photo.height}` : undefined;
const boxRatio = ratio ?? naturalRatio;
// Cap width at the photo's intrinsic size — several source files are small
// (791x445, 596x335) and go soft if stretched across a full-width band.
const style = [
  boxRatio ? `--imgslot-ratio:${boxRatio}` : '',
  photo ? `--imgslot-maxw:${photo.width}px` : '',
].filter(Boolean).join(';') || undefined;

// portrait | square | landscape — lets a caller lay tiles out by shape.
const orient = photo
  ? photo.width / photo.height < 0.95
    ? 'portrait'
    : photo.width / photo.height < 1.15
      ? 'square'
      : 'landscape'
  : undefined;
---

{photo ? (
  <figure
    class:list={['imgslot', 'imgslot-shot', cls]}
    style={style}
    data-motion={motionAttr}
    data-orient={orient}
  >
    <Image
      src={photo}
      alt={brief}
      widths={[640, 1024, 1600, 2200]}
      sizes={sizes}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
  </figure>
) : (
  <figure class:list={['imgslot', cls]} role="img" aria-label={brief} style={style} data-motion={motionAttr}>
    <b>{ref}</b>
    <span>{brief}</span>
  </figure>
)}
