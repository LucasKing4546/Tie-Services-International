---
/**
 * Publish performance figures and an overall bounding envelope only — never
 * an internal drum measurement, a flange's own diameter, or a component's
 * make or catalogue reference (CLAUDE.md §6, enforced at build time by
 * scripts/audit-protection.mjs — this comment is worded so it documents the
 * banned rows without itself matching the scan).
 *
 * A row whose value is the literal string "TO SUPPLY" renders <Gap> instead
 * of the raw text — frontmatter never carries HTML, so this is the one
 * place that convention gets interpreted.
 *
 * Known gap: Proof (Y-03) uses this as a certifications table, where every
 * certificate number should be "TO SUPPLY" too, but nothing enforces that —
 * a real certificate number typed as a row value builds clean with no warning.
 */
import type { SpecRow } from '@lib/blocks';
import Gap from './Gap.astro';

interface Props {
  caption?: string;
  rows: SpecRow[];
  footnote?: string;
}

const { caption = 'Representative specification', rows, footnote } = Astro.props;
---

<table class="spec">
  <caption>{caption}</caption>
  <tbody>
    {rows.map((row) => (
      <tr>
        <th scope="row">{row.k}</th>
        <td>
          {row.v === 'TO SUPPLY' ? <Gap>To be confirmed</Gap> : row.v}
          {row.note && <em>{row.note}</em>}
        </td>
      </tr>
    ))}
  </tbody>
</table>
{footnote && <p class="foot">{footnote}</p>}
