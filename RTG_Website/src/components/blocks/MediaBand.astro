---
/**
 * A full-bleed strip of photographs, edge to edge, with the brief under
 * each. A gallery, not a card list — nothing in it links anywhere, so the
 * site's carousel-not-grid rule doesn't apply. Tiles share one height and
 * crop to fill, so a 6016x4000 camera original and a 596x335 web image can
 * sit in the same row without either looking broken.
 */
import type { ImgBrief } from '@lib/blocks';
import { mediaFor } from '@data/media';
import ImageSlot from './ImageSlot.astro';

interface Props {
  items: ImgBrief[];
  eyebrow?: string;
  heading?: string;
  tone?: 'default' | 'off' | 'navy';
  /** Give the first tile double width — for a row with one clear lead shot. */
  lead?: boolean;
}

const { items, eyebrow, heading, tone = 'off', lead = false } = Astro.props;
const toneClass = tone === 'off' ? 'off' : tone === 'navy' ? 'navy' : '';

// A justified row: every tile shares one height and its width follows its
// own aspect ratio, growing from a zero basis (flex-grow: ratio), so
// width = k * ratio and height = width / ratio = k for every tile — heights
// come out equal with no cropping needed.
const tiles = items.map((m) => {
  const photo = mediaFor(m.ref);
  return { media: m, ratio: photo ? photo.width / photo.height : 4 / 3 };
});
const ratioSum = tiles.reduce((n, t) => n + t.ratio, 0) || 1;
// Each tile's real share of the row (container is ~88vw at max page width),
// so the browser picks a srcset candidate at least as wide as the box
// rather than one narrower that gets scaled up.
const sizesFor = (ratio: number) =>
  `(max-width: 900px) 100vw, ${Math.max(20, Math.round((ratio / ratioSum) * 92))}vw`;

// Three tiles, one upright: a justified row would stretch the two landscape
// tiles as tall as the portrait, reading as oddly wide. Detect that case and
// lay it out as a 2x2 grid instead, with the portrait tile first regardless
// of authored order.
const uprightCount = tiles.filter((t) => t.ratio < 1.15).length;
const stacked = tiles.length === 3 && uprightCount === 1;
const orderedTiles = stacked
  ? [...tiles].sort((a, b) => (a.ratio < 1.15 ? -1 : 0) - (b.ratio < 1.15 ? -1 : 0))
  : tiles;
---

{items.length > 0 && (
  <section class:list={['sec', 'mband', toneClass, { 'mband-lead': lead }]}>
    {(eyebrow || heading) && (
      <div class="wrap">
        <div class="sechd">
          {eyebrow && <p class="mono red">{eyebrow}</p>}
          {heading && <h2 class="d3"><span class="rl"><span>{heading}</span></span></h2>}
        </div>
      </div>
    )}
    <div class="wrap">
      <div class="mband-grid stag" data-count={items.length} data-shape={stacked ? 'stack' : 'row'}>
        {orderedTiles.map(({ media: m, ratio }) => (
          <figure class="mband-item" style={`flex-grow:${ratio.toFixed(4)}`}>
            <ImageSlot ref={m.ref} brief={m.brief} ratio={m.ratio} class="mband-plate" sizes={sizesFor(ratio)} />
            <figcaption>{m.brief}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
)}
