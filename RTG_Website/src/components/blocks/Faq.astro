---
/** .faq — a <dl> so it stays semantically a list of question/answer pairs.
 *  Templates that pass faqs also emit an FAQPage JSON-LD node from the same
 *  data (buildJsonLd's `extra` param) — see the Guide/Policy templates. */
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---

{items.length > 0 && (
  <dl class="faq">
    {items.map((item) => (
      <div>
        <dt>{item.q}</dt>
        <dd>{item.a}</dd>
      </div>
    ))}
  </dl>
)}
