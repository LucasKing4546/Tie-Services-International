---
/**
 * Copy one side, media the other, sides alternating down the page. Copy
 * goes in the default slot so an MDX body can be passed straight in.
 *
 * The media column is full-height rather than a fixed aspect box, so the
 * row is sized by its copy and the picture fills whatever height that
 * comes to — a short paragraph no longer leaves a letterboxed plate
 * stranded beside it.
 */
import type { ImgBrief, Link } from '@lib/blocks';
import ImageSlot from './ImageSlot.astro';

interface Props {
  eyebrow?: string;
  heading?: string;
  media?: ImgBrief;
  /** Puts the media on the left. Alternate it down a page. */
  reverse?: boolean;
  tone?: 'default' | 'off' | 'navy';
  cta?: Link;
  id?: string;
}

const { eyebrow, heading, media, reverse = false, tone = 'default', cta, id } = Astro.props;
const toneClass = tone === 'off' ? 'off' : tone === 'navy' ? 'navy' : '';
---

<section id={id} class:list={['sec', 'frow', toneClass, { 'frow-rev': reverse }]}>
  <div class="wrap frow-grid">
    <div class="frow-copy">
      {eyebrow && <p class="mono red fu">{eyebrow}</p>}
      {heading && <h2 class="d2"><span class="rl"><span>{heading}</span></span></h2>}
      <slot />
      {cta && <p class="frow-cta"><a class="arw" href={cta.href}>{cta.label} →</a></p>}
    </div>

    {media && (
      <div class="frow-media">
        <ImageSlot ref={media.ref} brief={media.brief} ratio={media.ratio} class="frow-plate" />
      </div>
    )}
  </div>
</section>
