---
/** Callout box. Registered as an MDX component so authors get <Note> with
 *  no import. */
interface Props {
  heading?: string;
  tone?: 'note' | 'warn';
}
const { heading, tone = 'note' } = Astro.props;
---

<div class:list={['note', { warn: tone === 'warn' }]}>
  {heading && <h3>{heading}</h3>}
  <p><slot /></p>
</div>
