---
/**
 * A full-bleed band holding a native, scroll-snapped row of cards. It moves
 * by swipe/drag or the prev/next buttons (initCarousels() in lib/motion.ts),
 * never by page scroll. The buttons stay display:none until html.js confirms
 * the script can drive them.
 */
interface Props {
  eyebrow?: string;
  heading: string;
  lede?: string;
}

const { heading, lede } = Astro.props;
import Icon from '@components/site/Icon.astro';
---

<section class="strack" data-scroll-track>
  <div class="strack-stick">
    <div class="wrap strack-head">
      <div>
        <h2 class="d3"><span class="rl"><span>{heading}</span></span></h2>
      </div>
      {lede && <p class="lede">{lede}</p>}
    </div>

    <div class="strack-rail" role="region" aria-label={heading} tabindex="0">
      <slot />
    </div>

    <div class="wrap strack-foot">
      <div class="strack-nav">
        <button type="button" class="strack-btn strack-prev" aria-label={`Previous: ${heading}`}><Icon name="prev" /></button>
        <button type="button" class="strack-btn strack-next" aria-label={`Next: ${heading}`}><Icon name="next" /></button>
      </div>
    </div>
  </div>
</section>
