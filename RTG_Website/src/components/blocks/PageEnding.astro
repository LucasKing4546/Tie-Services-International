---
/** The proof bar -> CTA -> draft-panel closing sequence shared by every template. */
import type { PageMeta } from '@data/pages';
import type { PageData } from '@lib/blocks';
import Section from './Section.astro';
import ProofBar from './ProofBar.astro';
import CtaBand from './CtaBand.astro';
import DraftPanel from './DraftPanel.astro';

interface Props {
  page: PageMeta;
  proofBar?: boolean;
  cta?: PageData['cta'];
  draft: boolean;
  outline: string[];
  /** Passed through to DraftPanel's own `note` — Legal's "legal review
   *  required" wording instead of the generic default. */
  draftNote?: string;
}

const { page, proofBar, cta, draft, outline, draftNote } = Astro.props;
---

{proofBar && (
  <Section tone="off" size="sm">
    <ProofBar />
  </Section>
)}

{cta && (
  <Section tone="off">
    <CtaBand
      heading={cta.heading}
      body={cta.body}
      primary={cta.primary}
      secondary={cta.secondary}
    />
  </Section>
)}

{draft && (
  <Section size="sm">
    <DraftPanel page={page} items={outline} note={draftNote} />
  </Section>
)}
