---
/**
 * A short list of destinations (2-4), as full-width ruled rows — the
 * fallback for a set of children too small for a carousel to have anything
 * to scroll (see ChildCards.astro's TRACK_MIN), and deliberately not a
 * grid either (site rule: carousels, not grids). Each title is set at
 * section-heading scale so a handful of rows still fill the band. No
 * numbering: these are alternatives, not steps.
 */
import type { CardItem } from '@lib/blocks';

interface Props {
  items: CardItem[];
  eyebrow?: string;
  heading?: string;
  lede?: string;
  tone?: 'default' | 'off' | 'navy';
}

const { items, eyebrow, heading, lede, tone = 'navy' } = Astro.props;
const toneClass = tone === 'off' ? 'off' : tone === 'navy' ? 'navy' : '';
---

{items.length > 0 && (
  <section class:list={['sec', 'irows', toneClass]}>
    <div class="wrap">
      {(eyebrow || heading) && (
        <div class="sechd">
          {eyebrow && <p class="mono red">{eyebrow}</p>}
          {heading && <h2 class="d3"><span class="rl"><span>{heading}</span></span></h2>}
          {lede && <p class="lede">{lede}</p>}
        </div>
      )}

      <ul class="irows-list stag">
        {items.map((item) => (
          <li>
            <a href={item.href}>
              <span class="irows-title">{item.title}</span>
              {item.blurb && <span class="irows-blurb">{item.blurb}</span>}
              <span class="irows-go" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
