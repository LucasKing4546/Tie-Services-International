---
/**
 * The dashed-red "this page is a working outline" panel, rendered when the
 * entry's frontmatter has draft: true. Defaults its block list to
 * PageMeta.blocks so a stub MDX file needs no outline of its own.
 */
import type { PageMeta } from '@data/pages';

interface Props {
  page: PageMeta;
  items?: string[];
  note?: string;
}

const { page, items, note = 'Content to be supplied by RTG before launch' } = Astro.props;
const list = items && items.length > 0 ? items : page.blocks;
---

<div class="draftnote">
  <h4>Draft page — {note}</h4>
  <p>This page is built, styled and carries its final metadata. The copy above is a working outline. The blocks it needs:</p>
  {list.length > 0 && <ul>{list.map((b) => <li>{b}</li>)}</ul>}
</div>
