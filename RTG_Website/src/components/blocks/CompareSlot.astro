---
/**
 * A before/after comparison — one image revealed over another by a divider
 * the visitor drags.
 *
 * Pointer- and keyboard-driven with role="slider" rather than scroll-driven
 * like the site's other set-pieces: a reader operating an A/B comparison
 * wants to stop halfway and go back, which is closer to <input type="range">
 * than to parallax.
 *
 * With no JS, both images stay stacked in normal flow with their labels —
 * still legible, just not interactive. The clip and the drag handle are
 * scoped to .on, which only initCompare() adds.
 */
import ImageSlot from './ImageSlot.astro';

interface Props {
  before: { ref: string; brief: string };
  after: { ref: string; brief: string };
  /** CSS aspect-ratio shared by both plates — they must match, or the
   *  divider would reveal a differently-shaped image underneath. */
  ratio?: string;
  beforeLabel?: string;
  afterLabel?: string;
}

const {
  before,
  after,
  ratio = '16/9',
  beforeLabel = 'Before',
  afterLabel = 'After',
} = Astro.props;
---

<figure class="cmp" data-compare>
  <div class="cmp-frame">
    <div class="cmp-base">
      <ImageSlot ref={after.ref} brief={after.brief} ratio={ratio} />
      <span class="cmp-tag cmp-tag-after">{afterLabel}</span>
    </div>
    <div class="cmp-reveal">
      <ImageSlot ref={before.ref} brief={before.brief} ratio={ratio} />
      <span class="cmp-tag cmp-tag-before">{beforeLabel}</span>
    </div>
    <button
      type="button"
      class="cmp-handle"
      role="slider"
      aria-label={`Reveal ${beforeLabel.toLowerCase()} or ${afterLabel.toLowerCase()}`}
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="50"
      aria-valuetext={`Half ${beforeLabel.toLowerCase()}, half ${afterLabel.toLowerCase()}`}
      aria-orientation="horizontal"
    >
      <span class="cmp-grip" aria-hidden="true"></span>
    </button>
  </div>
</figure>
<!-- No <figcaption>: each half already carries its own tag, and each
     ImageSlot is role="img" with an aria-label, so nothing is lost. -->
