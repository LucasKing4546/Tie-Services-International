---
/**
 * The Article template — C-07, "EU-origin fabrication" (the only page on
 * this template). Composition per the template plan: byline -> prose ->
 * .warn disclaimer. Article schema + dates.
 *
 * This is the first template to render a visible byline — every other
 * Article-schema template (Case, Proof, Guide, Policy) only feeds
 * data.article into structured data via articleJsonLd(). Article is framed
 * as a single-author piece rather than a page structured around blocks, so
 * the byline earns a visible line here. The ".warn disclaimer" is an
 * inline <Note tone="warn"> already in the MDX body (CLAUDE.md #5.7: RTG's
 * tariff/origin position must be confirmed before any definitive claim —
 * the page is deliberately still draft:true for exactly that reason).
 */
import { render } from 'astro:content';
import type { PageMeta } from '@data/pages';
import type { PageEntry } from '@lib/blocks';
import { hasBody } from '@lib/content';
import { articleJsonLd } from '@lib/seo';
import Base from '@layouts/Base.astro';
import PageHero from '@components/blocks/PageHero.astro';
import Section from '@components/blocks/Section.astro';
import Prose from '@components/blocks/Prose.astro';
import PageEnding from '@components/blocks/PageEnding.astro';
import { mdxComponents } from '@lib/mdx';

interface Props {
  page: PageMeta;
  entry: PageEntry;
}

const { page, entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

const byline = data.article
  ? [
      `By ${data.article.author}`,
      data.article.published?.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }),
    ]
      .filter(Boolean)
      .join(' · ')
  : '';
---

<Base pageId={page.id} jsonLdPage={articleJsonLd(data)}>
  <PageHero
    page={page}
    eyebrow={data.eyebrow}
    lede={data.lede}
    media={data.hero.media}
    ctas={data.hero.ctas}
  />

  {byline && (
    <Section size="sm">
      <p class="mono">{byline}</p>
    </Section>
  )}

  {hasBody(entry) && (
    <Section>
      <Prose>
        <Content components={mdxComponents} />
      </Prose>
    </Section>
  )}

  <PageEnding page={page} proofBar={data.proofBar} cta={data.cta} draft={data.draft} outline={data.outline} />
</Base>
