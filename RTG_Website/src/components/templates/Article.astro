---
/**
 * The Article template — C-07, "EU-origin fabrication" (the only page on
 * this template). Composition: byline -> prose -> .warn disclaimer.
 *
 * This is the only Article-schema template with a visible byline — Case,
 * Proof, Guide and Policy only feed data.article into articleJsonLd(). The
 * page stays draft: true because RTG's tariff/origin position isn't
 * confirmed yet (CLAUDE.md §5.7).
 */
import { render } from 'astro:content';
import type { PageMeta } from '@data/pages';
import type { PageEntry } from '@lib/blocks';
import { hasBody } from '@lib/content';
import { articleJsonLd } from '@lib/seo';
import Base from '@layouts/Base.astro';
import PageHero from '@components/blocks/PageHero.astro';
import Section from '@components/blocks/Section.astro';
import Prose from '@components/blocks/Prose.astro';
import Skeleton from '@components/blocks/Skeleton.astro';
import PageEnding from '@components/blocks/PageEnding.astro';
import { mdxComponents } from '@lib/mdx';

interface Props {
  page: PageMeta;
  entry: PageEntry;
}

const { page, entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

const byline = data.article
  ? [
      `By ${data.article.author}`,
      data.article.published?.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }),
    ]
      .filter(Boolean)
      .join(' · ')
  : '';
---

<Base pageId={page.id} jsonLdPage={articleJsonLd(data)}>
  <PageHero
    page={page}
    eyebrow={data.eyebrow}
    lede={data.lede}
    media={data.hero.media}
    ctas={data.hero.ctas}
    updated={data.updated}
  />

  {byline && (
    <Section size="sm">
      <p class="mono">{byline}</p>
    </Section>
  )}

  {hasBody(entry) && (
    <Section>
      <Prose>
        <Content components={mdxComponents} />
      </Prose>
    </Section>
  )}

  {data.draft && !hasBody(entry) && (
    <Skeleton label="Article body" kind="copy" count={5} />
  )}

  <PageEnding page={page} proofBar={data.proofBar} cta={data.cta} draft={data.draft} outline={data.outline} />
</Base>
