---
/**
 * The Guide template — L-02, "Refurbish, upgrade or replace?" (the only
 * page on this template). Composition: six factors as a numbered list ->
 * when replacement is recommended -> button to L-05. Article schema.
 *
 * The factors are authored as `steps[]` and render as a plain StepList: six
 * short statements read faster down a page than pinned one to a screen.
 * `faqs[]` is still honoured (as the list, and as a FAQPage node through
 * faqPageJsonLd()) for a guide written as real questions and answers.
 */
import { render } from 'astro:content';
import type { PageMeta } from '@data/pages';
import { endingCta, type PageEntry, type Step } from '@lib/blocks';
import { hasBody } from '@lib/content';
import { articleJsonLd, faqPageJsonLd } from '@lib/seo';
import Base from '@layouts/Base.astro';
import PageHero from '@components/blocks/PageHero.astro';
import Section from '@components/blocks/Section.astro';
import Prose from '@components/blocks/Prose.astro';
import StepList from '@components/blocks/StepList.astro';
import Skeleton from '@components/blocks/Skeleton.astro';
import PageEnding from '@components/blocks/PageEnding.astro';
import { mdxComponents } from '@lib/mdx';

interface Props {
  page: PageMeta;
  entry: PageEntry;
}

const { page, entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

const factors: Step[] = data.steps.length > 0
  ? data.steps
  : data.faqs.map((f) => ({ title: f.q, body: f.a, points: [] }));
---

<Base pageId={page.id} jsonLd={faqPageJsonLd(data)} jsonLdPage={articleJsonLd(data)}>
  <PageHero
    page={page}
    eyebrow={data.eyebrow}
    lede={data.lede}
    media={data.hero.media}
    ctas={data.hero.ctas}
    updated={data.updated}
  />

  {factors.length > 0 && (
    <Section>
      <StepList steps={factors} />
    </Section>
  )}

  {hasBody(entry) && (
    <Section tone="off">
      <Prose>
        <Content components={mdxComponents} />
      </Prose>
    </Section>
  )}

  {data.draft && !hasBody(entry) && (
    <Skeleton label="Guidance" kind="copy" count={4} />
  )}

  <PageEnding page={page} proofBar cta={endingCta(data)} draft={data.draft} outline={data.outline} />
</Base>
