---
/**
 * The Tier template — C-01…C-04, the four contract-manufacturing scope
 * tiers. Composition: hero (heading, scope paragraph, one button) -> the
 * body's two lists side by side ("Quality" or "Deliverables", and
 * "Required from you") -> sibling tier strip when `related` is set ->
 * button and the standard band.
 *
 * The plan describes the sibling strip as childrenOf('/contract-manufacturing/'),
 * but that hub's children are all nine C-01…C-09 pages, not just the four
 * tiers — so this reads each tier page's own `related` frontmatter instead,
 * which already lists exactly its three sibling tiers.
 */
import { render } from 'astro:content';
import type { PageMeta } from '@data/pages';
import { endingCta, type PageEntry, type CardItem } from '@lib/blocks';
import { cardFrom, hasBody } from '@lib/content';
import Base from '@layouts/Base.astro';
import PageHero from '@components/blocks/PageHero.astro';
import Section from '@components/blocks/Section.astro';
import SectionHead from '@components/blocks/SectionHead.astro';
import Prose from '@components/blocks/Prose.astro';
import CardGrid from '@components/blocks/CardGrid.astro';
import Card from '@components/blocks/Card.astro';
import Skeleton from '@components/blocks/Skeleton.astro';
import PageEnding from '@components/blocks/PageEnding.astro';
import { mdxComponents } from '@lib/mdx';

interface Props {
  page: PageMeta;
  entry: PageEntry;
}

const { page, entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

const siblingTiers: CardItem[] = data.related.map((id) => cardFrom({ pageId: id }));
---

<Base pageId={page.id}>
  <PageHero
    page={page}
    eyebrow={data.eyebrow}
    lede={data.lede}
    media={data.hero.media}
    ctas={data.hero.ctas}
    updated={data.updated}
  />

  {hasBody(entry) && (
    <Section>
      <Prose class="lists">
        <Content components={mdxComponents} />
      </Prose>
    </Section>
  )}

  {siblingTiers.length > 0 && (
    <Section tone="off">
      <SectionHead eyebrow="The scope ladder" heading="The other tiers" level={2} />
      <CardGrid cols={3} label="The other contract-manufacturing tiers">
        {siblingTiers.map((item) => <Card item={item} />)}
      </CardGrid>
    </Section>
  )}

  {data.draft && !hasBody(entry) && (
    <Skeleton label="Scope detail" kind="copy" count={4} />
  )}

  <PageEnding page={page} proofBar cta={endingCta(data)} draft={data.draft} outline={data.outline} />
</Base>
