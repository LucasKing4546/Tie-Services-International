---
/**
 * The Sector template — S-01…S-07. The market the buyer identifies with;
 * P1 in the workbook. Composition per the template plan: parallax hero ->
 * problem (sticky media) -> equipment from related[] -> featured case band
 * -> proof bar -> CTA.
 */
import { render } from 'astro:content';
import { page as lookupPage, type PageMeta } from '@data/pages';
import type { PageEntry, CardItem } from '@lib/blocks';
import { cardFrom, entryFor } from '@lib/content';
import Base from '@layouts/Base.astro';
import PageHero from '@components/blocks/PageHero.astro';
import Section from '@components/blocks/Section.astro';
import Prose from '@components/blocks/Prose.astro';
import MediaBand from '@components/blocks/MediaBand.astro';
import StepList from '@components/blocks/StepList.astro';
import SectionHead from '@components/blocks/SectionHead.astro';
import ScrollTrack from '@components/blocks/ScrollTrack.astro';
import IndexRows from '@components/blocks/IndexRows.astro';
import Card from '@components/blocks/Card.astro';
import FeaturedCase from '@components/blocks/FeaturedCase.astro';
import Skeleton from '@components/blocks/Skeleton.astro';
import PageEnding from '@components/blocks/PageEnding.astro';
import { mdxComponents } from '@lib/mdx';

interface Props {
  page: PageMeta;
  entry: PageEntry;
}

const { page, entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

const equipment: CardItem[] = data.related.map((id) => cardFrom({ pageId: id }));

// A featured case links to a specific Case-template page — everything the
// band shows is read from that page's own entry (see FeaturedCase.astro).
// A `featured` card without a pageId (title+href only) has nothing to
// resolve here, so the band is simply skipped rather than guessed at.
const featured = data.featured?.pageId
  ? { page: lookupPage(data.featured.pageId), entry: await entryFor(data.featured.pageId), ctaLabel: data.featured.cta }
  : undefined;

// The second frontmatter media entry, if a page has supplied one, runs
// alongside the opening prose as the feature row's picture.
// Every photograph the page carries beyond the hero. They all go to the
// band, which gives them the full page width, rather than one of them being
// spent as a column beside prose.
const restMedia = data.media;
---

<Base pageId={page.id}>
  <PageHero
    page={page}
    eyebrow={data.eyebrow}
    lede={data.lede}
    media={data.hero.media}
    ctas={data.hero.ctas}
    updated={data.updated}
  />

  {/* The body runs at its own measure rather than in a feature row.
      A feature row is for a short block — a heading and a few sentences
      beside a picture, which is how it is used on the reference site. Given
      a whole MDX body it does the opposite of its job: the copy is squeezed
      into a narrow column while a short picture leaves most of the other
      one empty, which was the dead space down the right of every sector
      page. The photographs are better spent in the band below, where they
      get the full width. */}
  <Section>
    <Prose>
      <Content components={mdxComponents} />
    </Prose>
  </Section>

  {equipment.length >= 5 ? (
    <ScrollTrack eyebrow="Equipment" heading="Built for this sector">
      {equipment.map((item) => <Card item={item} tone="dark" />)}
    </ScrollTrack>
  ) : equipment.length > 0 && (
    <IndexRows
      items={equipment}
      eyebrow="Equipment"
      heading="Built for this sector"
      lede="The machines this sector's work actually turns on."
    />
  )}

  {data.steps.length > 0 && (
    <Section>
      <SectionHead
        eyebrow="Technical note"
        heading="What actually goes wrong"
        level={2}
        lede="The failure modes behind the specification, in the order you meet them."
      />
      <StepList steps={data.steps} />
    </Section>
  )}

  {/* No heading: each picture carries its own caption, and a fixed one
      ("Equipment for this sector") is wrong the moment a page's photograph
      is a diagram or a vessel rather than a machine. */}
  <MediaBand items={restMedia} lead />

  {/* Where a block has no content yet, draw its shape rather than omit it —
      the page then shows what it will look like filled in, which is the
      thing worth seeing while the copy is still being written. */}
  {data.draft && data.steps.length === 0 && (
    <Skeleton label="Technical note" kind="rows" count={3} tone="off" />
  )}
  {data.draft && restMedia.length === 0 && (
    <Skeleton label="Equipment photography" kind="media" />
  )}

  {featured && (
    <Section wrap={false}>
      <FeaturedCase page={featured.page} entry={featured.entry} ctaLabel={featured.ctaLabel} />
    </Section>
  )}

  {/* No proof bar here. The six site-wide PROOF figures are a general claim
      about RTG; a sector page's job is to be specific to one buyer's problem,
      and closing it with the same boxed grid of numbers that every other
      template shows undercut that. The figures still appear where they are
      the point — the Proof section, and inline via <Fig> where a sector's own
      copy cites one. */}
  <PageEnding page={page} cta={data.cta} draft={data.draft} outline={data.outline} />
</Base>
