---
/**
 * The Sector template — S-01…S-07. The market the buyer identifies with;
 * P1 in the workbook. Composition: hero (heading, one-line intro, two
 * buttons) -> the body's short headed lists in two columns -> photographs
 * -> related equipment from related[] -> buttons and the standard band.
 *
 * Deliberately short. The copy is a set of lists a buyer checks against a
 * specification, not an argument to read, so there is no featured-case band
 * and no technical-note sequence here any more; a case study is a sentence
 * with a link in the body.
 */
import { render } from 'astro:content';
import type { PageMeta } from '@data/pages';
import { endingCta, type PageEntry, type CardItem } from '@lib/blocks';
import { cardFrom, hasBody } from '@lib/content';
import Base from '@layouts/Base.astro';
import PageHero from '@components/blocks/PageHero.astro';
import Section from '@components/blocks/Section.astro';
import Prose from '@components/blocks/Prose.astro';
import MediaBand from '@components/blocks/MediaBand.astro';
import IndexRows from '@components/blocks/IndexRows.astro';
import PageEnding from '@components/blocks/PageEnding.astro';
import { mdxComponents } from '@lib/mdx';

interface Props {
  page: PageMeta;
  entry: PageEntry;
}

const { page, entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

const equipment: CardItem[] = data.related.map((id) => cardFrom({ pageId: id }));
---

<Base pageId={page.id}>
  <PageHero
    page={page}
    lede={data.lede}
    media={data.hero.media}
    ctas={data.hero.ctas}
    updated={data.updated}
  />

  {hasBody(entry) && (
    <Section>
      <Prose class="lists">
        <Content components={mdxComponents} />
      </Prose>
    </Section>
  )}

  {/* No heading: each picture carries its own caption. */}
  <MediaBand items={data.media} />

  <IndexRows items={equipment} heading="Related equipment" tone="default" />

  <PageEnding page={page} proofBar cta={endingCta(data)} draft={data.draft} outline={data.outline} />
</Base>
