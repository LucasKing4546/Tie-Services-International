---
/**
 * The Hub template — section landing pages (Sectors, Equipment, Winches,
 * Lifecycle, Proof, Resources...). Composition: intro -> ChildCards from
 * childrenOf(slug) -> proof bar -> CTA. Children are derived, never
 * hand-written, so a new Page Map row under a hub's slug appears here
 * automatically.
 *
 * A hub may also curate `cards` in frontmatter for a cross-link outside its
 * own branch (P-00's Proof hub linking to Y-03 Certifications, which lives
 * under /yards-integrators/) — those append into the same grid via
 * ChildCards' `extra` prop rather than a second, disconnected one.
 */
import { render } from 'astro:content';
import { childrenOf, type PageMeta } from '@data/pages';
import type { PageEntry } from '@lib/blocks';
import { cardFrom, hasBody, isIntro } from '@lib/content';
import { absolute } from '@lib/seo';
import Base from '@layouts/Base.astro';
import PageHero from '@components/blocks/PageHero.astro';
import Section from '@components/blocks/Section.astro';
import Prose from '@components/blocks/Prose.astro';
import ChildCards from '@components/blocks/ChildCards.astro';
import FeatureRow from '@components/blocks/FeatureRow.astro';
import Skeleton from '@components/blocks/Skeleton.astro';
import PageEnding from '@components/blocks/PageEnding.astro';
import { mdxComponents } from '@lib/mdx';

interface Props {
  page: PageMeta;
  entry: PageEntry;
}

const { page, entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

const children = childrenOf(page.slug);
const extraCards = data.cards.map(cardFrom);

const introMedia = data.media[0];

// Drawn empty (with the shoot brief) when no picture exists yet, same rule
// the sector pages follow.
const tallSlot = introMedia ?? {
  ref: `IMG-${page.id}-V`,
  brief: 'Vertical shot — equipment in build or rigged on deck, full height of the machine.',
  ratio: '3/4',
};

const trackHeading = children.length > 0 ? `Everything in ${page.section.toLowerCase()}` : 'Where to go next';

// gridItems mirrors exactly what ChildCards renders below, built from the
// same two sources, so the ItemList structured data can never disagree with
// the visible grid. Only emitted for pages typed CollectionPage — a couple
// of Hub pages (L-00, Y-00) carry a workbook schema of "Service" instead.
const gridItems = [
  ...children.map((c) => ({ name: c.name, url: absolute(c.slug) })),
  ...extraCards.map((c) => ({ name: c.title, url: absolute(c.href) })),
];
const jsonLdPage =
  gridItems.length > 0 && page.schema === 'CollectionPage'
    ? {
        mainEntity: {
          '@type': 'ItemList',
          itemListElement: gridItems.map((item, i) => ({
            '@type': 'ListItem',
            position: i + 1,
            ...item,
          })),
        },
      }
    : {};
---

<Base pageId={page.id} jsonLdPage={jsonLdPage}>
  <PageHero
    page={page}
    eyebrow={data.eyebrow}
    lede={data.lede}
    media={data.hero.media}
    ctas={data.hero.ctas}
    updated={data.updated}
  />

  {/* A short intro gets the two-column treatment, opening line at display
      scale. A body with its own sections runs beside a tall picture instead
      — in two columns it would put one heading on the left and stack
      everything else on the right, leaving most of the screen empty. */}
  {hasBody(entry) && isIntro(entry) && (
    <Section tone="off">
      <Prose class="lead-para">
        <Content components={mdxComponents} />
      </Prose>
    </Section>
  )}
  {hasBody(entry) && !isIntro(entry) && (
    <FeatureRow media={tallSlot}>
      <Prose>
        <Content components={mdxComponents} />
      </Prose>
    </FeatureRow>
  )}

  {gridItems.length > 0 && (
    <ChildCards
      of={page.slug}
      extra={extraCards}
      track
      eyebrow={page.section}
      heading={trackHeading}
      label={`Pages under ${page.h1}`}
    />
  )}

  {data.draft && !hasBody(entry) && (
    <Skeleton label="Section introduction" kind="copy" count={4} />
  )}

  <PageEnding page={page} proofBar={data.proofBar} cta={data.cta} draft={data.draft} outline={data.outline} />
</Base>
