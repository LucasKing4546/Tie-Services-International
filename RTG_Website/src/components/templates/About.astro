---
/**
 * The About template — A-01…A-04. Composition: prose -> stats -> facility
 * media slots -> siblings from childrenOf('/about/').
 *
 * There's no separate About hub — A-01 sits at '/about/' and doubles as the
 * section landing page, so siblings are read from the fixed '/about/' path
 * rather than each page's own slug (childrenOf(own slug) would return
 * nothing for A-02…A-04). This also surfaces A-05 (Careers, a different
 * template but slugged under /about/) in A-01's sibling grid.
 *
 * Only A-01 has real, confirmed prose; A-02…A-04 stay `draft: true` —
 * CLAUDE.md §5/§7 treats headcount, facility specifics and certificate
 * numbers as RTG-only-supplied facts, not to be invented.
 */
import { render } from 'astro:content';
import { childrenOf, type PageMeta } from '@data/pages';
import type { PageEntry } from '@lib/blocks';
import { hasBody } from '@lib/content';
import { articleJsonLd } from '@lib/seo';
import Base from '@layouts/Base.astro';
import PageHero from '@components/blocks/PageHero.astro';
import Section from '@components/blocks/Section.astro';
import SectionHead from '@components/blocks/SectionHead.astro';
import Prose from '@components/blocks/Prose.astro';
import StatsStrip from '@components/blocks/StatsStrip.astro';
import ImageSlot from '@components/blocks/ImageSlot.astro';
import ChildCards from '@components/blocks/ChildCards.astro';
import PageEnding from '@components/blocks/PageEnding.astro';
import { mdxComponents } from '@lib/mdx';

interface Props {
  page: PageMeta;
  entry: PageEntry;
}

const { page, entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

const siblings = childrenOf('/about/').filter((p) => p.id !== page.id);
// A-03/A-04's workbook schema is Article, matching every other
// Article-schema template — wired through even though neither sets
// `article` frontmatter yet.
const jsonLdPage = articleJsonLd(data);
---

<Base pageId={page.id} jsonLdPage={jsonLdPage}>
  <PageHero
    page={page}
    eyebrow={data.eyebrow}
    lede={data.lede}
    media={data.hero.media}
    ctas={data.hero.ctas}
    updated={data.updated}
  />

  {hasBody(entry) && (
    <Section>
      <Prose>
        <Content components={mdxComponents} />
      </Prose>
    </Section>
  )}

  {data.stats.length > 0 && (
    <Section tone="off" size="sm">
      <StatsStrip items={data.stats} />
    </Section>
  )}

  {data.media.length > 0 && (
    <Section>
      <SectionHead eyebrow="The facility" heading="Where the work happens" level={2} />
      <div class="two">
        {data.media.map((m) => <ImageSlot ref={m.ref} brief={m.brief} ratio={m.ratio} />)}
      </div>
    </Section>
  )}

  {siblings.length > 0 && (
    <Section tone="off">
      <SectionHead eyebrow="About" heading="More about RTG" level={2} />
      <ChildCards of="/about/" exclude={[page.id]} label="More about RTG" />
    </Section>
  )}

  <PageEnding page={page} proofBar={data.proofBar} cta={data.cta} draft={data.draft} outline={data.outline} />
</Base>
