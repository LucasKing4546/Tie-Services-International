---
/**
 * The Product template — equipment detail pages (winches, LARS, cranes,
 * power units...). Composition: hero -> .two (sticky-rail spec table(s) +
 * "why it is built this way" prose) -> applications -> gated-datasheet CTA
 * -> closing CTA. Proof-point copy lives inline in the MDX body (it needs
 * <Fig> figures), so it scrolls past alongside the spec rail rather than
 * as a separate block.
 */
import { render } from 'astro:content';
import { page as lookupPage, type PageMeta } from '@data/pages';
import type { PageEntry } from '@lib/blocks';
import { hasBody } from '@lib/content';
import Base from '@layouts/Base.astro';
import PageHero from '@components/blocks/PageHero.astro';
import Section from '@components/blocks/Section.astro';
import SectionHead from '@components/blocks/SectionHead.astro';
import Prose from '@components/blocks/Prose.astro';
import SpecTable from '@components/blocks/SpecTable.astro';
import FeatureRow from '@components/blocks/FeatureRow.astro';
import MediaBand from '@components/blocks/MediaBand.astro';
import TagList from '@components/blocks/TagList.astro';
import Skeleton from '@components/blocks/Skeleton.astro';
import PageEnding from '@components/blocks/PageEnding.astro';
import { mdxComponents } from '@lib/mdx';

interface Props {
  page: PageMeta;
  entry: PageEntry;
}

const { page, entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

// Every published spec row becomes a schema.org additionalProperty — except
// TO SUPPLY rows, which render <Gap> on the page and have nothing confirmed
// to publish either. Deliberately no `offers`: a made-to-order machine has
// no price, and inventing one to chase a rich result is the brochure
// behaviour CLAUDE.md forbids.
// With several configurations the caption is prefixed so identical row names don't collide.
const additionalProperty = data.specs.flatMap((s) =>
  s.rows
    .filter((r) => r.v !== 'TO SUPPLY')
    .map((r) => ({
      '@type': 'PropertyValue',
      name: data.specs.length > 1 ? `${s.caption}: ${r.k}` : r.k,
      value: r.v,
    })),
);

const datasheetPage = data.product?.datasheetPageId ? lookupPage(data.product.datasheetPageId) : undefined;
// Carries this product's name into R-01's "Equipment" field so the visitor
// never has to retype it — see lib/forms.ts's generic name-matched prefill.
const datasheetHref = datasheetPage ? `${datasheetPage.slug}?equipment=${encodeURIComponent(page.h1)}` : undefined;
---

<Base
  pageId={page.id}
  jsonLdPage={{
    ...(data.product?.category ? { category: data.product.category } : {}),
    ...(additionalProperty.length > 0 ? { additionalProperty } : {}),
  }}
>
  <PageHero
    page={page}
    eyebrow={data.eyebrow}
    lede={data.lede}
    media={data.hero.media}
    ctas={data.hero.ctas}
    updated={data.updated}
  />

  {hasBody(entry) && (
    <Section>
      <Prose>
        <Content components={mdxComponents} />
      </Prose>
    </Section>
  )}

  {/* One row per configuration: its photo beside its own table. */}
  {data.specs.map((s, i) => (
    <>
      <FeatureRow
        eyebrow={data.specs.length > 1 ? `Configuration ${i + 1} of ${data.specs.length}` : 'Specification'}
        heading={s.caption}
        media={s.media[0]}
        reverse={i % 2 === 1}
        tone={i % 2 === 1 ? 'off' : 'default'}
      >
        <SpecTable caption="Specification" rows={s.rows} footnote={s.footnote} />
      </FeatureRow>
      {s.media.length > 1 && <MediaBand items={s.media.slice(1)} tone={i % 2 === 1 ? 'off' : 'default'} />}
    </>
  ))}

  {datasheetHref && data.specs.length > 0 && (
    <Section>
      <a class="btn b-navy" href={datasheetHref}>Request the full datasheet →</a>
    </Section>
  )}

  {data.draft && data.specs.length === 0 && (
    <Skeleton label="Specification table" kind="split" count={4} />
  )}

  {data.product && data.product.applications.length > 0 && (
    <Section tone="off">
      <SectionHead eyebrow="Applications" heading="Where this runs" level={2} />
      <TagList items={data.product.applications} />
    </Section>
  )}

  {data.draft && (!data.product || data.product.applications.length === 0) && (
    <Skeleton label="Applications" kind="rows" count={2} tone="off" />
  )}

  <PageEnding page={page} proofBar={data.proofBar} cta={data.cta} draft={data.draft} outline={data.outline} />
</Base>
