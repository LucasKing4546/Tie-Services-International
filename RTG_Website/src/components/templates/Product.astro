---
/**
 * The Product template — equipment detail pages (winches, LARS, cranes,
 * power units...). Composition: hero -> .two (sticky-rail spec table(s) +
 * "why it is built this way" prose) -> applications -> gated-datasheet CTA
 * -> closing CTA. Proof-point copy lives inline in the MDX body (it needs
 * <Fig> figures), so it scrolls past alongside the spec rail rather than
 * as a separate block.
 */
import { render } from 'astro:content';
import { page as lookupPage, type PageMeta } from '@data/pages';
import type { PageEntry } from '@lib/blocks';
import { hasBody } from '@lib/content';
import Base from '@layouts/Base.astro';
import PageHero from '@components/blocks/PageHero.astro';
import Section from '@components/blocks/Section.astro';
import SectionHead from '@components/blocks/SectionHead.astro';
import Prose from '@components/blocks/Prose.astro';
import SpecTable from '@components/blocks/SpecTable.astro';
import FeatureRow from '@components/blocks/FeatureRow.astro';
import MediaBand from '@components/blocks/MediaBand.astro';
import StatsStrip from '@components/blocks/StatsStrip.astro';
import TagList from '@components/blocks/TagList.astro';
import Skeleton from '@components/blocks/Skeleton.astro';
import PageEnding from '@components/blocks/PageEnding.astro';
import { mdxComponents } from '@lib/mdx';

interface Props {
  page: PageMeta;
  entry: PageEntry;
}

const { page, entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

// Every published spec row becomes a schema.org additionalProperty — except
// TO SUPPLY rows, which render <Gap> on the page and have nothing confirmed
// to publish either. Deliberately no `offers`: a made-to-order machine has
// no price, and inventing one to chase a rich result is the brochure
// behaviour CLAUDE.md forbids.
// With several configurations the caption is prefixed so identical row names don't collide.
const additionalProperty = data.specs.flatMap((s) =>
  s.rows
    .filter((r) => r.v !== 'TO SUPPLY')
    .map((r) => ({
      '@type': 'PropertyValue',
      name: data.specs.length > 1 ? `${s.caption}: ${r.k}` : r.k,
      value: r.v,
    })),
);

// Up to three headline figures per configuration (load, one duty figure,
// weight), taken from its own table. Long values are skipped so the big type fits.
const glance = (rows: { k: string; v: string }[]) =>
  [/working load limit|maximum tension/i, /cable capacity|line speed|linear speed|sea state/i, /dry weight/i]
    .map((re) => rows.find((r) => re.test(r.k) && r.v !== 'TO SUPPLY' && r.v.length <= 14))
    .filter((r): r is { k: string; v: string } => Boolean(r))
    .map((r) => ({ value: r.v, label: r.k, accent: false }));

const datasheetPage = data.product?.datasheetPageId ? lookupPage(data.product.datasheetPageId) : undefined;
// Carries this product's name into R-01's "Equipment" field so the visitor
// never has to retype it — see lib/forms.ts's generic name-matched prefill.
const datasheetHref = datasheetPage ? `${datasheetPage.slug}?equipment=${encodeURIComponent(page.h1)}` : undefined;
---

<Base
  pageId={page.id}
  jsonLdPage={{
    ...(data.product?.category ? { category: data.product.category } : {}),
    ...(additionalProperty.length > 0 ? { additionalProperty } : {}),
  }}
>
  <PageHero
    page={page}
    eyebrow={data.eyebrow}
    lede={data.lede}
    media={data.hero.media}
    ctas={data.hero.ctas}
    updated={data.updated}
  />

  {hasBody(entry) && (
    <Section>
      <Prose>
        <Content components={mdxComponents} />
      </Prose>
    </Section>
  )}

  {data.specs.length > 1 && (
    <nav class="cfg-nav" aria-label="Configurations">
      <ul class="wrap">
        {data.specs.map((s, i) => (
          <li><a href={`#config-${i + 1}`} title={s.caption}>{s.caption.split(',')[0]}</a></li>
        ))}
      </ul>
    </nav>
  )}

  {/* One row per configuration: its photo beside its own table. */}
  {data.specs.map((s, i) => (
    <>
      <FeatureRow
        id={`config-${i + 1}`}
        heading={s.caption.replace(/(\d) (m|kg|Te|kW)\b/g, '$1 $2')}
        media={s.media[0]}
        reverse={i % 2 === 1}
        tone={i % 2 === 1 ? 'off' : 'default'}
      >
        {glance(s.rows).length >= 2 && <StatsStrip items={glance(s.rows)} />}
        <SpecTable caption="Specification" rows={s.rows} footnote={s.footnote} />
        {s.rows.some((r) => /first layer/i.test(r.k)) && (
          <p class="note-line">First layer is the innermost wrap of cable on the drum, top layer the outermost. Line pull falls and line speed rises as layers build.</p>
        )}
      </FeatureRow>
      {s.media.length > 1 && <MediaBand items={s.media.slice(1)} tone={i % 2 === 1 ? 'off' : 'default'} />}
    </>
  ))}

  {datasheetHref && data.specs.length > 0 && (
    <div class="req-bar" data-req-bar hidden>
      <span>Full specification, sent to you by name.</span>
      <a class="btn b-navy" href={datasheetHref}>Request the datasheet →</a>
    </div>
  )}

  {datasheetHref && data.specs.length > 0 && (
    <Section>
      <a class="btn b-navy" href={datasheetHref}>Request the datasheet →</a>
      <p class="note-line">Sent to you by name, watermarked and serial-numbered.</p>
    </Section>
  )}

  {data.draft && data.specs.length === 0 && (
    <Skeleton label="Specification table" kind="split" count={4} />
  )}

  {data.product && data.product.applications.length > 0 && (
    <Section tone="off">
      <SectionHead eyebrow="Applications" heading="Where this runs" level={2} />
      <TagList items={data.product.applications} />
    </Section>
  )}

  {data.draft && (!data.product || data.product.applications.length === 0) && (
    <Skeleton label="Applications" kind="rows" count={2} tone="off" />
  )}

  <PageEnding page={page} proofBar={data.proofBar} cta={data.cta} draft={data.draft} outline={data.outline} />
</Base>

<style is:global>
  .cfg-nav ul { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; margin: 0 auto; padding-block: 16px; }
  .cfg-nav a { display: inline-block; padding: 8px 16px; border: 1px solid var(--line); border-radius: 999px; color: var(--navy); text-decoration: none; font-size: 14px; }
  .cfg-nav a:hover { border-color: var(--navy); }
  .frow[id^="config-"] { scroll-margin-top: 96px; }
  .req-bar { position: fixed; inset: auto 0 0 0; z-index: 40; display: flex; align-items: center; justify-content: center; gap: 16px; flex-wrap: wrap; padding: 10px 16px; background: #fff; border-top: 1px solid var(--line); color: var(--navy); font-size: 14px; }
  .req-bar[hidden] { display: none; }
  @media (max-width: 700px) { .req-bar span { display: none; } }
  @media (prefers-reduced-motion: no-preference) {
    .req-bar { animation: req-in .25s ease-out; }
    @keyframes req-in { from { transform: translateY(100%); } }
  }
</style>

<script>
  // No JS = the bar stays hidden. Shown once the first spec table has entered
  // the viewport, and stays shown after that.
  const init = () => {
    const bar = document.querySelector<HTMLElement>('[data-req-bar]');
    const first = document.querySelector('.frow[id^="config-"] table, .frow[id^="config-"]');
    if (!bar || !first || !('IntersectionObserver' in window)) return;
    const io = new IntersectionObserver((es) => {
      if (es.some((e) => e.isIntersecting)) {
        bar.hidden = false;
        document.body.style.paddingBottom = `${bar.offsetHeight}px`;
        io.disconnect();
      }
    });
    io.observe(first);
  };
  document.addEventListener('astro:page-load', init);
</script>
