---
/**
 * The Ladder template — the contract-manufacturing scope ladder (C-00), the
 * only page on this template. Composition: four tiers -> references -> CTA
 * to C-09 (send documentation).
 *
 * The plan describes each tier's points as read from that tier's own MDX
 * frontmatter, but C-01…C-04 carry that detail as prose, not a structured
 * points list — so this reads C-00's own frontmatter `steps` (a hand-written
 * summary) instead, with `related` resolved into a reference grid linking
 * to each tier page.
 *
 * Known debt: nothing keeps C-00's step summary in sync with what each tier
 * page's own prose says. If a tier's scope changes, both need updating by
 * hand.
 *
 * The four tiers render as TierCard (picture-background) in a ScrollTrack,
 * not StepList's plain rows — every other Step[] consumer (Service, Tier,
 * Guide) still uses StepList; only Ladder wants the carousel treatment.
 */
import { render } from 'astro:content';
import type { PageMeta } from '@data/pages';
import type { PageEntry, CardItem } from '@lib/blocks';
import { cardFrom, hasBody } from '@lib/content';
import Base from '@layouts/Base.astro';
import PageHero from '@components/blocks/PageHero.astro';
import Section from '@components/blocks/Section.astro';
import SectionHead from '@components/blocks/SectionHead.astro';
import Prose from '@components/blocks/Prose.astro';
import ScrollTrack from '@components/blocks/ScrollTrack.astro';
import TierCard from '@components/blocks/TierCard.astro';
import CardGrid from '@components/blocks/CardGrid.astro';
import Card from '@components/blocks/Card.astro';
import Skeleton from '@components/blocks/Skeleton.astro';
import PageEnding from '@components/blocks/PageEnding.astro';
import { mdxComponents } from '@lib/mdx';

interface Props {
  page: PageMeta;
  entry: PageEntry;
}

const { page, entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

const references: CardItem[] = data.related.map((id) => cardFrom({ pageId: id }));
---

<Base pageId={page.id}>
  <PageHero
    page={page}
    eyebrow={data.eyebrow}
    lede={data.lede}
    media={data.hero.media}
    ctas={data.hero.ctas}
    updated={data.updated}
  />

  {hasBody(entry) && (
    <Section>
      <Prose>
        <Content components={mdxComponents} />
      </Prose>
    </Section>
  )}

  {data.steps.length > 0 && (
    <ScrollTrack
      eyebrow="The scope ladder"
      heading="Four tiers, cumulative"
      lede="Each one contains everything below it. Most relationships start at Tier 1 with a single sub-assembly and move up as trust is earned."
    >
      {data.steps.map((s) => <TierCard step={s} label="Tier" />)}
    </ScrollTrack>
  )}

  {references.length > 0 && (
    <Section>
      <SectionHead eyebrow="References" heading="Each tier in detail" level={2} />
      <CardGrid cols={2} label="Each tier in detail">
        {references.map((item) => <Card item={item} />)}
      </CardGrid>
    </Section>
  )}

  {data.draft && !hasBody(entry) && (
    <Skeleton label="Tier detail" kind="rows" count={4} />
  )}

  <PageEnding page={page} proofBar={data.proofBar} cta={data.cta} draft={data.draft} outline={data.outline} />
</Base>
