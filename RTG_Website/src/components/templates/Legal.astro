---
/**
 * The Legal template — Z-01…Z-04 (privacy, cookies, terms, accessibility).
 * Composition per the template plan: narrow prose, TOC from the h2s,
 * last-updated. DraftPanel carries "LEGAL REVIEW REQUIRED" until reviewed.
 *
 * `.prose` already caps body text at 68ch (blocks.css) — that's the "narrow
 * prose" the plan asks for, nothing extra needed. The TOC comes straight
 * from render()'s own `headings` array (astro:content), filtered to depth
 * 2 — the MDX body is the single source for both the rendered content and
 * its own table of contents, so they can never drift apart. `updated`
 * (content.config.ts, top-level, unused until now) drives both a visible
 * "last updated" line and `dateModified` in JSON-LD.
 *
 * None of these four pages have real policy text yet (CLAUDE.md §5: every
 * page here needs an actual legal review) — PageEnding's `draftNote`
 * carries the reference build's own "legal review required" wording
 * (site_build/site_data.py's draft() convention) instead of the generic
 * "content to be supplied" default every other draft template gets.
 */
import { render } from 'astro:content';
import type { PageMeta } from '@data/pages';
import type { PageEntry } from '@lib/blocks';
import { hasBody } from '@lib/content';
import Base from '@layouts/Base.astro';
import PageHero from '@components/blocks/PageHero.astro';
import Section from '@components/blocks/Section.astro';
import SectionHead from '@components/blocks/SectionHead.astro';
import Prose from '@components/blocks/Prose.astro';
import PageEnding from '@components/blocks/PageEnding.astro';
import { mdxComponents } from '@lib/mdx';

interface Props {
  page: PageMeta;
  entry: PageEntry;
}

const { page, entry } = Astro.props;
const { data } = entry;
const { Content, headings } = await render(entry);

const toc = headings.filter((h) => h.depth === 2);
const updatedLabel = data.updated
  ? data.updated.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })
  : undefined;

const jsonLdPage = data.updated ? { dateModified: data.updated.toISOString() } : {};
---

<Base pageId={page.id} jsonLdPage={jsonLdPage}>
  <PageHero page={page} eyebrow={data.eyebrow} lede={data.lede} />

  {updatedLabel && (
    <Section size="sm">
      <p class="mono">Last updated {updatedLabel}</p>
    </Section>
  )}

  {toc.length > 1 && (
    <Section size="sm">
      <SectionHead eyebrow="Contents" heading="On this page" level={3} reveal={false} />
      <nav aria-label="Table of contents">
        <ul class="lc-l">
          {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
        </ul>
      </nav>
    </Section>
  )}

  {hasBody(entry) && (
    <Section>
      <Prose>
        <Content components={mdxComponents} />
      </Prose>
    </Section>
  )}

  <PageEnding
    page={page}
    proofBar={data.proofBar}
    cta={data.cta}
    draft={data.draft}
    outline={data.outline}
    draftNote="legal review required before launch"
  />
</Base>
