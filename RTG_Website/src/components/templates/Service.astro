---
/**
 * The Service template — six lifecycle/manufacturing service pages
 * (refurbishment, class renewal, spares, bespoke design, structural
 * subcontracting, deck equipment packages). Composition: hero (heading,
 * one-line intro, two buttons) -> StepList -> body -> notes -> related
 * cards -> buttons and the standard band.
 *
 * The steps run first: on L-01 the six-step process is the page, and the
 * body under it is what follows from it (third-party equipment, lead
 * times). A page with no `steps` is just its body.
 */
import { render } from 'astro:content';
import type { PageMeta } from '@data/pages';
import { endingCta, type PageEntry, type CardItem } from '@lib/blocks';
import { cardFrom, hasBody } from '@lib/content';
import Base from '@layouts/Base.astro';
import PageHero from '@components/blocks/PageHero.astro';
import Section from '@components/blocks/Section.astro';
import SectionHead from '@components/blocks/SectionHead.astro';
import Prose from '@components/blocks/Prose.astro';
import StepList from '@components/blocks/StepList.astro';
import Note from '@components/blocks/Note.astro';
import CardGrid from '@components/blocks/CardGrid.astro';
import Card from '@components/blocks/Card.astro';
import Skeleton from '@components/blocks/Skeleton.astro';
import PageEnding from '@components/blocks/PageEnding.astro';
import { mdxComponents } from '@lib/mdx';

interface Props {
  page: PageMeta;
  entry: PageEntry;
}

const { page, entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

const related: CardItem[] = data.related.map((id) => cardFrom({ pageId: id }));
---

<Base pageId={page.id}>
  <PageHero
    page={page}
    eyebrow={data.eyebrow}
    lede={data.lede}
    media={data.hero.media}
    ctas={data.hero.ctas}
    updated={data.updated}
  />

  {data.steps.length > 0 && (
    <Section>
      <StepList steps={data.steps} />
    </Section>
  )}

  {hasBody(entry) && (
    <Section tone="off">
      <Prose>
        <Content components={mdxComponents} />
      </Prose>
    </Section>
  )}

  {data.draft && data.steps.length === 0 && (
    <Skeleton label="How the work runs" kind="rows" count={4} tone="off" />
  )}

  {data.notes.length > 0 && (
    <Section>
      {data.notes.map((n) => <Note heading={n.heading}>{n.body}</Note>)}
    </Section>
  )}

  {related.length > 0 && (
    <Section tone="off">
      <SectionHead eyebrow="Related" heading="Where to go next" level={2} />
      <CardGrid cols={3} label="Where to go next">
        {related.map((item) => <Card item={item} />)}
      </CardGrid>
    </Section>
  )}

  <PageEnding page={page} proofBar cta={endingCta(data)} draft={data.draft} outline={data.outline} />
</Base>
