---
import { NAV } from '@data/site.js';
interface Props { currentPath?: string }
const { currentPath = '' } = Astro.props;
const isActive = (href: string) => currentPath === href || (href !== '/' && currentPath.startsWith(href));
---
<header class="hdr" id="hdr" transition:persist>
  <div class="wrap hdr-in">
    <a class="brand" href="/">
      <img class="logo" src="/logo-rtg.png" alt="Romica Tie Group" width="378" height="102" />
    </a>
    <nav class="nav" aria-label="Primary">
      {NAV.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
      <a class="btn b-red" href="/contact/">Talk to an engineer</a>
    </nav>

    {/* <details> disclosure, not a JS-driven button — opens, closes and is
       keyboard operable with no script. NAV is duplicated here rather than
       moved between two places (no CSS can do that); only one copy is ever
       rendered at a time (the other is display:none), so screen readers
       never meet a duplicate landmark. */}
    <details class="mnav" id="mnav">
      <summary class="mnav-btn" aria-label="Menu">
        <span class="mnav-bars" aria-hidden="true"><i></i></span>
      </summary>
      <div class="mnav-panel">
        <nav aria-label="Primary">
          {NAV.map((item) => (
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
          ))}
          <a class="btn b-red" href="/contact/">Talk to an engineer</a>
        </nav>
      </div>
    </details>
  </div>
</header>
<script>
  const hdr = document.getElementById('hdr');
  if (hdr) addEventListener('scroll', () => hdr.classList.toggle('on', scrollY > 30), { passive: true });

  // <header> carries transition:persist, so client-side navigation reuses
  // this DOM node instead of re-rendering it — aria-current from the new
  // page is never applied. Recompute it from the URL instead, mirroring
  // isActive() above.
  function syncNav() {
    const path = location.pathname;
    document.querySelectorAll<HTMLAnchorElement>('#hdr .nav a[href], #hdr .mnav-panel a[href]').forEach((a) => {
      const href = a.getAttribute('href');
      if (!href) return;
      const active = path === href || (href !== '/' && path.startsWith(href));
      if (active) a.setAttribute('aria-current', 'page');
      else a.removeAttribute('aria-current');
    });
  }
  document.addEventListener('astro:page-load', syncNav);

  // Escape, click-away and close-on-navigate — the header persists across
  // view transitions, so without the last of these the panel would stay
  // open over the page the visitor just chose.
  const mnav = document.getElementById('mnav') as HTMLDetailsElement | null;
  if (mnav) {
    const close = () => mnav.removeAttribute('open');

    addEventListener('keydown', (e) => {
      if (e.key !== 'Escape' || !mnav.open) return;
      close();
      mnav.querySelector<HTMLElement>('.mnav-btn')?.focus();
    });

    addEventListener('click', (e) => {
      if (mnav.open && !mnav.contains(e.target as Node)) close();
    });

    mnav.querySelectorAll('a[href]').forEach((a) => a.addEventListener('click', close));
    document.addEventListener('astro:page-load', close);
  }
</script>
