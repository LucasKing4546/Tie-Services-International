---
import { FOOTER_NAV, LEGAL_NAV, SITE, PROOF } from '@data/site.js';
const year = new Date().getFullYear();
---
<footer class="ftr" data-zone="Seabed" transition:persist>
  <svg class="seabed" viewBox="0 0 1200 46" preserveAspectRatio="none" aria-hidden="true">
    <path d="M-2 48 V26 L70 22 L150 31 L240 14 L310 24 L390 9 L480 27 L560 17 L650 29 L730 12 L830 24 L910 7 L1000 22 L1090 15 L1202 27 V48Z" />
  </svg>
  <div class="wrap">
    <div class="ftr-g">
      <div>
        <a class="brand" href="/">
          <img class="logo" src="/logo-rtg.png" alt="Romica Tie Group" width="378" height="102" />
        </a>
        <p class="ftr-blurb">
          Family-owned designers and manufacturers of custom deck machinery for research,
          survey and offshore vessels since {PROOF.since}. Designed in the UK, built and tested
          in Satu Mare, Romania.
        </p>
      </div>
      {FOOTER_NAV.map((col) => (
        <div>
          <h3>{col.heading}</h3>
          <ul>{col.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
        </div>
      ))}
    </div>
    <div class="ftr-b">
      <span>© {year} {SITE.name}. All drawings and technical publications remain our copyright.</span>
      <span>{LEGAL_NAV.map((l, i) => <>{i > 0 && ' · '}<a href={l.href}>{l.label}</a></>)}</span>
    </div>
  </div>
</footer>
