---
// The concept's register: one ruled row per item, led by a photograph of the
// equipment itself, so the band shows the work rather than a menu. Used for
// Sectors and Equipment. An item with no photograph yet keeps an empty plate
// (crane and portable-spread photography is still to come from RTG).
import Icon from '@components/site/Icon.astro';
import { Image } from 'astro:assets';
import { mediaFor } from '@data/media';

interface Props {
  heading: string;
  items: { title: string; blurb: string; href: string; ref?: string }[];
  class: string;
}
const { heading, items, class: cls } = Astro.props;
---
<section class:list={['sec', cls]}>
  <div class="wrap">
    <h2 class="d2"><span class="rl"><span>{heading}</span></span></h2>
    <ul class="mkt-list stag">
      {items.map((s) => {
        const photo = s.ref ? mediaFor(s.ref) : undefined;
        return (
          <li>
            <a href={s.href}>
              <span class:list={['mkt-img', { 'is-plate': !photo }]}>
                {photo && <Image src={photo} alt="" widths={[240, 480]} sizes="200px" loading="lazy" decoding="async" />}
              </span>
              <h3>{s.title}</h3>
              <p>{s.blurb}</p>
              <span class="mkt-go" aria-hidden="true"><Icon name="arrow" /></span>
            </a>
          </li>
        );
      })}
    </ul>
    <slot />
  </div>
</section>
