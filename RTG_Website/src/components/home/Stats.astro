---
import { HERO_STATS } from '@data/home';
import { isNumericStat, statDigits, statSuffix } from '@lib/blocks';
---
<section class="sec sm" style="padding-top:0">
  <div class="wrap">
    <div class="stats stag">
      {HERO_STATS.map((s) => (
        <div class="stat">
          <b>
            {isNumericStat(s.value) ? (
              <>
                {s.accent
                  ? <em class="ct" data-to={statDigits(s.value)}>0</em>
                  : <span class="ct" data-to={statDigits(s.value)}>0</span>}
                {statSuffix(s.value)}
              </>
            ) : (
              <Fragment set:html={s.value.replace('/', '<span style="color:var(--red)">/</span>')} />
            )}
          </b>
          <span>{s.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>
