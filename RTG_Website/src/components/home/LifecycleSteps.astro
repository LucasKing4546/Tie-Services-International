---
// Service life support: the words and actions on the left, working deck
// equipment in service at sea on the right (an RTG deck spread under way).
import { Image } from 'astro:assets';
import { SERVICE } from '@data/home';
import deck from '../../assets/equipment/e00-deck-spread.jpg';
---
<section class="sec service" id="lifecycle">
  <div class="wrap service-in">
    <div>
      <h2 class="d2"><span class="rl"><span>{SERVICE.heading}</span></span></h2>
      <p class="lede fu">{SERVICE.body}</p>
      <div class="hero-cta fu">
        <a class="btn b-red" href={SERVICE.ctas[0].href}>{SERVICE.ctas[0].label}</a>
        <a class="btn btn-o" href={SERVICE.ctas[1].href}>{SERVICE.ctas[1].label}</a>
      </div>
    </div>
    <figure class="band-photo service-photo fu">
      <Image src={deck} alt="" widths={[640, 1100]} sizes="(max-width:900px) 100vw, 560px" loading="lazy" />
    </figure>
  </div>
</section>
