---
// Service life support: the last thing before the seabed.
import { SERVICE } from '@data/home';
---
<section data-zone="Service life" class="sec service" id="lifecycle">
  <div class="wrap">
    <h2 class="d2"><span class="rl"><span>{SERVICE.heading}</span></span></h2>
    <p class="lede fu">{SERVICE.body}</p>
    <div class="hero-cta fu">
      <a class="btn b-red" href={SERVICE.ctas[0].href}>{SERVICE.ctas[0].label}</a>
      <a class="btn btn-o" href={SERVICE.ctas[1].href}>{SERVICE.ctas[1].label}</a>
    </div>
  </div>
</section>
