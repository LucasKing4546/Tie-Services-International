---
// Full-bleed photo beat after the 3D hero — a real vessel at sea with RTG
// equipment fitted. The vessel is a named client's (visible on the
// wheelhouse), published on the user's explicit instruction. Naming the
// client in this block's copy was separately authorised by the user on
// 2026-10-07 — that covers this block only. See @data/media for the
// provenance note.
import { Image } from 'astro:assets';
import homeFleet from '../../assets/home/home-fleet-vessel.jpg';
---
<section data-zone="Fleet" class="fleet">
  <Image
    src={homeFleet}
    alt="A survey vessel underway at sea, RTG deck handling equipment fitted across the working deck."
    widths={[900, 1440, 2000, 2600]}
    sizes="100vw"
    loading="lazy"
    decoding="async"
  />
  <div class="fleet-cap">
    <h2 class="fleet-line fu">Proven on the World’s Leading Multi-Role Survey Fleets.</h2>
    <p class="fleet-sub fu">Decades of collaboration with tier-one ocean survey operators
    like Fugro. From containerised handling spreads to permanent deepwater winches, we
    engineer equipment that mobilises quickly, stays in class, and delivers reliable
    uptime season after season.</p>
  </div>
</section>
