---
/**
 * Full-bleed photographic beat, straight after the 3D hero. The hero proves
 * we can model the machine; this proves the machine is real — a vessel at
 * sea, RTG equipment fitted and working. iCOMAT's mould calls for a big
 * media reveal early, and this is the one photograph on the whole site that
 * earns that placement.
 *
 * The vessel is a named client's (visible on the wheelhouse) — published on
 * the user's explicit instruction. That authorises the photograph only; no
 * copy on this page or anywhere else names the client. See the provenance
 * note in @data/media.
 */
import { Image } from 'astro:assets';
import homeFleet from '../../assets/home/home-fleet-vessel.jpg';
---
<section class="fleet">
  <Image
    src={homeFleet}
    alt="A survey vessel underway at sea, RTG deck handling equipment fitted across the working deck."
    widths={[900, 1440, 2000, 2600]}
    sizes="100vw"
    loading="eager"
    decoding="async"
  />
  <div class="fleet-cap">
    <p class="mono fu">At work, not in the studio</p>
    <p class="fleet-line fu">Equipment we built, on a vessel earning its keep.</p>
  </div>
</section>
