---
// Full-bleed photo beat after the 3D hero — a real vessel at sea with RTG
// equipment fitted. The vessel is a named client's (visible on the
// wheelhouse), published on the user's explicit instruction — that
// authorises the photo only, no copy anywhere names the client. See
// @data/media for the provenance note.
import { Image } from 'astro:assets';
import homeFleet from '../../assets/home/home-fleet-vessel.jpg';
---
<section class="fleet">
  <Image
    src={homeFleet}
    alt="A survey vessel underway at sea, RTG deck handling equipment fitted across the working deck."
    widths={[900, 1440, 2000, 2600]}
    sizes="100vw"
    loading="lazy"
    decoding="async"
  />
  <div class="fleet-cap">
    <p class="fleet-line fu">Equipment we built, on a vessel earning its keep.</p>
  </div>
</section>
