---
import { Image } from 'astro:assets';
import { mediaFor } from '@data/media';
const bg = mediaFor('IMG-L00-A');
---
<section class="sec stmt navy">
  {bg && <Image src={bg} alt="" widths={[1200, 2000]} sizes="100vw" loading="lazy" class="stmt-bg" />}
  <div class="wrap stmt-grid">
    <div>
      <h2 class="d2">
        <span class="rl"><span>The fleet is older</span></span>
        <span class="rl"><span>than it has ever been.</span></span>
      </h2>
    </div>
    <div class="fu">
      <p class="lede">Replacement costs more than the market will bear. That makes the deck
      machinery already on your vessel worth looking after properly: assessed honestly,
      rebuilt where it's worth rebuilding, and re-certified before it goes back to sea.</p>
      <a class="arw" href="/lifecycle/">Lifecycle &amp; refurbishment →</a>
    </div>
  </div>
</section>
