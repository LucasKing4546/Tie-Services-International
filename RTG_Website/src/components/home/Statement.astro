---
// The company, last before the seabed, in the concept's About layout: the
// heading and timeline on the left (STORY's own sentences,
// TIMELINE in @data/home), a machine on test and the client line on the
// right. The client names in STORY were authorised on 2026-10-08. The page
// closes on the two enquiry routes (labels as used by the hub heroes and
// the header).
import Icon from '@components/site/Icon.astro';
import { Image } from 'astro:assets';
import { STORY, TIMELINE } from '@data/home';
import { mediaFor } from '@data/media';

const photo = mediaFor('IMG-E02-D');
---
<section class="sec stmt">
  <div class="wrap">
    <div class="about">
      <div>
        <h2 class="d2"><span class="rl"><span>{STORY.heading}</span></span></h2>
        <ol class="timeline stag">
          {TIMELINE.map((t) => <li><span class="tl-year">{t.year}</span><span class="tl-text">{t.text}</span></li>)}
        </ol>
      </div>
      <div class="about-side fu">
        {photo && (
          <figure class="band-photo about-photo">
            <Image src={photo} alt="" widths={[640, 1100]} sizes="(max-width:900px) 100vw, 600px" loading="lazy" />
          </figure>
        )}
        <div class="stmt-side">
          <h3 class="d3">{STORY.trustedHeading}</h3>
          <p>{STORY.trusted}</p>
          <a class="arw" href={STORY.link.href}>{STORY.link.label} <Icon name="arrow" /></a>
          <div class="hero-cta">
            <a class="btn b-red" href="/contact/request-a-quotation/">Request a quotation</a>
            <a class="btn btn-o" href="/contact/">Talk to an engineer</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
