---
// "Engineered for offshore conditions": the four engineering points beside a
// winch on the shop floor, guarded drum and level wind in view (the
// concept's control-and-monitoring band, carried by what RTG has confirmed).
import { Image } from 'astro:assets';
import { CONDITIONS } from '@data/home';
import { mediaFor } from '@data/media';

const photo = mediaFor('IMG-E02-A');
---
<section class="sec cond">
  <div class="wrap cond-in">
    <div class="cond-head">
      <h2 class="d2"><span class="rl"><span>{CONDITIONS.heading}</span></span></h2>
      {photo && (
        <figure class="band-photo cond-photo">
          <Image src={photo} alt="" widths={[640, 1100]} sizes="(max-width:900px) 100vw, 560px" loading="lazy" />
        </figure>
      )}
    </div>
    <ul class="cond-list stag">
      {CONDITIONS.points.map((p) => <li><b>{p.lead}</b><span>{p.text}</span></li>)}
    </ul>
  </div>
</section>
