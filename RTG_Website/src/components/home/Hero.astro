---
/**
 * The homepage opens above the water: headline on the sky, a survey vessel
 * arriving on the waterline, and its hoist line paying out as you scroll
 * (--sy, set by src/lib/depth.ts). The proof figures are the first thing
 * under the surface.
 *
 * The vessel is a drawn silhouette, not a model of any real ship.
 */
import { HERO_PROOF } from '@data/home';
import Waterline from '@components/site/Waterline.astro';
---
<section data-zone="Surface" class="hero">
  <div class="hero-sky above">
    <div class="wrap">
      <h1 class="d1">
        <span class="rl"><span>Built for</span></span>
        <span class="rl"><span>the work,</span></span>
        <span class="rl"><span>not the <i>brochure.</i></span></span>
      </h1>
      <p class="lede fu">Winches, launch and recovery systems and deck handling for
      research, survey and offshore vessels. Twenty-two years of it, and the machines
      we built at the start are still working.</p>
      <div class="hero-cta fu">
        <a class="btn b-navy" href="/sectors/">Find your sector<span class="dot"></span></a>
        <a class="btn btn-o" href="/proof/">See the evidence</a>
      </div>
      <p class="hero-origin fu">Designed in the UK. Built and tested in Romania. Since 2003.</p>
    </div>

    <Waterline>
      <div class="vessel">
        <svg viewBox="0 0 520 200">
          <g class="vessel-hull">
            <path d="M8 138 L58 196 H482 L494 138 Z" />
            <rect x="108" y="96" width="126" height="42" />
            <rect x="128" y="68" width="84" height="28" />
            <path d="M162 68 L167 22 H171 L176 68 Z" />
            <rect x="169" y="34" width="26" height="3" />
            <rect x="169" y="46" width="16" height="3" />
            <circle cx="198" cy="60" r="8" />
            <rect x="252" y="102" width="30" height="36" />
            <rect x="326" y="120" width="50" height="18" />
            <path d="M426 138 L482 66 M458 138 L500 66 M476 66 H506" fill="none" stroke-width="7" stroke-linecap="square" />
          </g>
          <rect class="vessel-band" x="252" y="108" width="30" height="8" />
          <rect class="vessel-glass" x="136" y="76" width="68" height="7" />
        </svg>
        <div class="hoist"><span class="hoist-load"></span></div>
      </div>
    </Waterline>
  </div>

  <div class="wrap hero-under">
    <dl class="hero-proof stag">
      {HERO_PROOF.map((p) => <div><dt>{p.label}</dt><dd>{p.value}</dd></div>)}
    </dl>
  </div>
</section>
