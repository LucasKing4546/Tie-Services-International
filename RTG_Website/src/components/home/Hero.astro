---
import { HERO_PROOF } from '@data/home';
---
<section class="hero">
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="tick" aria-hidden="true"></div>
  <div class="wrap hero-grid">
    <div>
      <p class="mono red fu" style="margin:0 0 30px">Deck equipment from Satu Mare, since 2003</p>
      <h1 class="d1">
        <span class="rl"><span>Built for</span></span>
        <span class="rl"><span>the work,</span></span>
        <span class="rl"><span>not the <i>brochure.</i></span></span>
      </h1>
      <div class="hero-sub">
        <p class="lede fu" style="margin:0">Winches, launch and recovery systems and deck handling for
        research, survey and offshore vessels. Twenty-two years of it, and the machines
        we built at the start are still working.</p>
      </div>
      <div class="hero-cta fu">
        <a class="btn b-navy" href="/sectors/">Find your sector<span class="dot"></span></a>
        <a class="btn btn-o" href="/proof/">See the evidence</a>
      </div>
      <dl class="hero-proof fu">
        {HERO_PROOF.map((p) => <div><dt>{p.label}</dt><dd>{p.value}</dd></div>)}
      </dl>
    </div>
    <div class="artbox">
      <div class="artbox-in fu">
        <canvas id="heroGL" role="img" aria-label="3D model of an RTG deck crane"></canvas>
        <span class="cap">Deck crane, indicative model, not CAD. Drag to rotate</span>
      </div>
    </div>
  </div>
</section>