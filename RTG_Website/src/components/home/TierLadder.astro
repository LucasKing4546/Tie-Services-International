---
// Contract manufacturing: the pinned four-tier ladder, with the 3D winch
// built up one tier at a time (home-scroll.ts).
import { MANUFACTURING, TIERS } from '@data/home';
---
<section data-zone="Manufacturing" class="pin-wrap" id="tiers">
  <div class="pin-stick">
    <div class="wrap pin-grid">
      <div class="pin-vis"><canvas id="tierGL" role="img"
        aria-label="3D winch assembly building up one manufacturing tier at a time"></canvas></div>
      <div>
        <h2 class="d3 tier-h">{MANUFACTURING.heading}</h2>
        <p class="tier-intro">{MANUFACTURING.body}</p>
        <div class="pin-copy">
          {TIERS.map((t, i) => (
            <article class={`tier${i === 0 ? ' on' : ''}`} data-t={i}>
              <div class="num">{t.n}</div>
              <h3 class="d3">{t.title}</h3>
              <p class="lede">{t.lede}</p>
              <ul>{t.points.map((pt) => <li>{pt}</li>)}</ul>
            </article>
          ))}
        </div>
        <div class="pin-bar" aria-hidden="true">{TIERS.map((t, i) => <i class={i === 0 ? 'on' : ''}><b>{t.n}</b><span>{t.title}</span></i>)}</div>
        <p style="margin-top:30px"><a class="arw" href={MANUFACTURING.link.href}>{MANUFACTURING.link.label} →</a></p>
      </div>
    </div>
  </div>
</section>
