---
// Contract manufacturing: the four cumulative tiers side by side, all visible
// at once (they were tabs; four short columns read faster than a tab row and
// need no script). Each column links to its tier page.
import Icon from '@components/site/Icon.astro';
import SectionHead from '@components/blocks/SectionHead.astro';
import { MANUFACTURING, TIERS } from '@data/home';
---
<section class="sec tiers-sec" id="tiers">
  <div class="wrap">
    <SectionHead heading={MANUFACTURING.heading} lede={MANUFACTURING.body} />
    <ol class="tiers stag">
      {TIERS.map((t) => (
        <li>
          <span class="tier-n">{t.n}</span>
          <h3><a href={t.href}>{t.title}</a></h3>
          <p>{t.lede}</p>
          <ul>{t.points.map((pt) => <li>{pt}</li>)}</ul>
        </li>
      ))}
    </ol>
    <p class="tiers-more"><a class="arw" href={MANUFACTURING.link.href}>{MANUFACTURING.link.label} <Icon name="arrow" /></a></p>
  </div>
</section>
