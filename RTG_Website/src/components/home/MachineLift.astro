---
// "Engineered for offshore conditions": the four engineering points, then the
// showroom — one machine in open water, turned by drag (home-scroll.ts).
import { CONDITIONS, MACHINES } from '@data/home';
const first = MACHINES[0];
---
<section data-zone="Engineering" class="sec sm cond">
  <div class="wrap">
    <h2 class="d2"><span class="rl"><span>{CONDITIONS.heading}</span></span></h2>
    <ul class="cond-list stag">
      {CONDITIONS.points.map((p) => <li>{p}</li>)}
    </ul>
  </div>
</section>

<section data-zone="Engineering" class="zw" id="showcase">
  <div class="zs">
    <div class="zf" id="zFrame">
      <canvas id="showGL" role="img" aria-label="3D model of RTG deck equipment. Drag to turn it."></canvas>
      <div class="zf-in">
        <div class="zf-top">
          <div id="mHead">
            <h3 id="mName" set:html={first.name} />
            <p class="sub" id="mDesc">{first.desc}</p>
          </div>
          <div class="zf-pick" id="mPick">
            {MACHINES.map((m, i) => (
              <button type="button" class={i === 0 ? 'on' : ''} aria-pressed={i === 0 ? 'true' : 'false'} data-m={i}>{m.label}</button>
            ))}
          </div>
        </div>
        <div></div>
        <div class="zf-bot">
          <div class="spec" id="mSpec">
            {first.spec.map(([b, l]) => <div><b>{b}</b><span>{l}</span></div>)}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
