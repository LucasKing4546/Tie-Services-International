---
import Base from '@layouts/Base.astro';
---
<Base pageId="H-01">
  <section class="sec" style="padding-top:180px;min-height:60vh">
    <div class="wrap">
      <p class="mono red" style="margin:0 0 24px">Error 404</p>
      <h1 class="d2" style="max-width:16ch">That page is not on this deck.</h1>
      <p class="lede" style="margin-top:24px">
        The link may be from the old site. Every legacy URL has a redirect — if you
        reached this from a search result, tell us and we will fix the map.
      </p>
      <p style="margin-top:28px">
        <a class="btn b-navy" href="/">Back to the homepage</a>
        <a class="btn btn-o" href="/contact/" style="margin-left:10px">Contact us</a>
      </p>
    </div>
  </section>
</Base>
