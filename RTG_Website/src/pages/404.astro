---
import Base from '@layouts/Base.astro';
import PageHero from '@components/blocks/PageHero.astro';
import { resolvePage } from '@lib/page';

// Renders through PageHero, like every other page, so page.h1 (pages-extra.ts)
// stays the single source of truth for this text rather than being
// duplicated as a literal string here.
const { p } = resolvePage('X-404');
---
<Base pageId="X-404">
  <PageHero
    page={p}
    eyebrow="Error 404"
    lede="The link may be from the old site. Every legacy URL has a redirect — if you reached this from a search result, tell us and we will fix the map."
    ctas={[
      { label: 'Back to the homepage', href: '/' },
      { label: 'Contact us', href: '/contact/' },
    ]}
    crumbs={false}
  />
</Base>
