---
import Base from '@layouts/Base.astro';
import Hero from '@components/home/Hero.astro';
import Marquee from '@components/home/Marquee.astro';
import Statement from '@components/home/Statement.astro';
import Stats from '@components/home/Stats.astro';
import TierLadder from '@components/home/TierLadder.astro';
import SectorTrack from '@components/home/SectorTrack.astro';
import MachineLift from '@components/home/MachineLift.astro';
import EquipmentGrid from '@components/home/EquipmentGrid.astro';
import ProofCase from '@components/home/ProofCase.astro';
import LifecycleSteps from '@components/home/LifecycleSteps.astro';
import '@/styles/home.css';
---
<Base pageId="H-01">
  <Hero />
  <Marquee />
  <Statement />
  <Stats />
  <TierLadder />
  <SectorTrack />
  <MachineLift />
  <EquipmentGrid />
  <ProofCase />
  <LifecycleSteps />

  <Fragment slot="body-end">
    <script>
      // three.js is ~600 kB — fetch it only once the browser is idle, and only
      // on this page. Everything above renders and is readable without it.
      //
      // Booted from 'astro:page-load', not from here directly: this module's
      // top-level code runs once per document, and ClientRouter never re-runs
      // it, so a client-side return trip to / would arrive with no 3D and no
      // homepage motion at all. The event fires on first load and again after
      // every navigation. initHome() is idempotent — it tears the previous
      // page's stages down first, and bails when the homepage isn't in the
      // document, which is what releases the WebGL contexts on the way out.
      const boot = () => {
        const start = () => import('@lib/home-scroll').then((m) => m.initHome());
        if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 1500 });
        else setTimeout(start, 200);
      };
      document.addEventListener('astro:page-load', boot);
    </script>
  </Fragment>
</Base>
