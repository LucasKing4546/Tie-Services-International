---
import Base from '@layouts/Base.astro';
import Hero from '@components/home/Hero.astro';
import Statement from '@components/home/Statement.astro';
import Conditions from '@components/home/Conditions.astro';
import SectorTrack from '@components/home/SectorTrack.astro';
import TierLadder from '@components/home/TierLadder.astro';
import LifecycleSteps from '@components/home/LifecycleSteps.astro';
import IndexRows from '@components/blocks/IndexRows.astro';
import FinderEntry from '@components/home/FinderEntry.astro';
import { EQUIPMENT } from '@data/home';
import '@/styles/home.css';
---
<Base pageId="H-01">
  <Hero />
  <Statement />
  <Conditions />
  <SectorTrack />
  <IndexRows items={EQUIPMENT} heading="Equipment" tone="default" />
  <FinderEntry />
  <TierLadder />
  <LifecycleSteps />
</Base>
