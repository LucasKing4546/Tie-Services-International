---
/**
 * The homepage, in the order of romica-website-concept.html's front page:
 * sectors, case studies, equipment, engineering, manufacturing, service,
 * then the company. Every section is a solid band one shade deeper than
 * the last (home.css).
 *
 * Deliberate gaps from the page map's H-01 blocks (decided 2026-11-04):
 * no avatar doors or strips (the routes are the sections themselves), and
 * no featured case or bulletin sign-up until RTG supplies the content. The
 * client quotes (Voices) were added on the site owner's instruction of
 * 2026-11-05; see VOICES in @data/home for their permission note. A Gap
 * marker here would noindex the homepage (CLAUDE.md §5b).
 */
import Base from '@layouts/Base.astro';
import Hero from '@components/home/Hero.astro';
import Statement from '@components/home/Statement.astro';
import Voices from '@components/home/Voices.astro';
import Conditions from '@components/home/Conditions.astro';
import PhotoList from '@components/blocks/PhotoList.astro';
import CaseStudies from '@components/home/CaseStudies.astro';
import TierLadder from '@components/home/TierLadder.astro';
import LifecycleSteps from '@components/home/LifecycleSteps.astro';
import FinderEntry from '@components/home/FinderEntry.astro';
import { EQUIPMENT, SECTORS } from '@data/home';
import '@/styles/home.css';

const sectors = SECTORS.map((s) => ({ title: s.name, blurb: s.blurb, href: s.href, ref: s.ref }));
---
<Base pageId="H-01">
  <Hero />
  <div class="home-main">
    <PhotoList class="mkts" heading="Sectors" items={sectors} />
    <CaseStudies />
    <PhotoList class="equip" heading="Equipment" items={EQUIPMENT}>
      <FinderEntry />
    </PhotoList>
    <Conditions />
    <TierLadder />
    <LifecycleSteps />
    <Voices />
    <Statement />
  </div>
</Base>
