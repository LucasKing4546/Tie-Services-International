---
/**
 * The homepage. The hero's hoist line carries on below the surface as the
 * page's spine (.home-spine, home.css): every section's top rule runs across
 * to it, and the hoist load lands at its foot beside "Service life support".
 *
 * Deliberate gaps from the page map's H-01 blocks (decided 2026-11-04):
 * no avatar doors or strips (the routes are the sections themselves), and
 * no testimonials, featured case or bulletin sign-up until RTG supplies the
 * content. A Gap marker here would noindex the homepage (CLAUDE.md §5b).
 */
import Base from '@layouts/Base.astro';
import Hero from '@components/home/Hero.astro';
import Statement from '@components/home/Statement.astro';
import Conditions from '@components/home/Conditions.astro';
import SectorTrack from '@components/home/SectorTrack.astro';
import TierLadder from '@components/home/TierLadder.astro';
import LifecycleSteps from '@components/home/LifecycleSteps.astro';
import IndexRows from '@components/blocks/IndexRows.astro';
import FinderEntry from '@components/home/FinderEntry.astro';
import { EQUIPMENT } from '@data/home';
import '@/styles/home.css';
---
<Base pageId="H-01">
  <Hero />
  <div class="home-spine">
    <Statement />
    <Conditions />
    <SectorTrack />
    <IndexRows items={EQUIPMENT} heading="Equipment" tone="default">
      <FinderEntry />
    </IndexRows>
    <TierLadder />
    <LifecycleSteps />
  </div>
</Base>
